#!/usr/bin/env python3
"""Real-Time Live Monitor for `aw` (`agent-weave`).

Provides an interactive Terminal User Interface (TUI) live monitor and an
optional Live Web Server (`--web`) streaming events via Server-Sent Events (SSE).
Adheres strictly to ASD-STE100 technical style and zero-emoji invariants.
"""

from __future__ import annotations

import argparse
import curses
import json
import math
import os
from pathlib import Path
import re
import sqlite3
import subprocess
import sys
import textwrap
import time
from typing import Any, Dict, List, Optional, Tuple


def resolve_global_aw_dir() -> Path:
    """Resolve global ~/.aw directory, honoring AW_GLOBAL_DIR."""
    val = os.environ.get("AW_GLOBAL_DIR")
    if val and val.strip():
        return Path(val.strip())
    home = os.environ.get("HOME") or os.environ.get("USERPROFILE") or "."
    return Path(home) / ".aw"


def format_age_secs(diff: int) -> str:
    """Format duration in human-readable compact form."""
    if diff < 0:
        return "now"
    if diff < 60:
        return f"{diff}s ago"
    elif diff < 3600:
        return f"{diff // 60}m ago"
    elif diff < 86400:
        return f"{diff // 3600}h ago"
    else:
        return f"{diff // 86400}d ago"


def collect_memories_for_tui(aw_dir: Path, repo_paths: Dict[str, Path]) -> List[Dict[str, Any]]:
    """Load active memories across global store and discovered repositories."""
    stores: Dict[str, Path] = {}
    g = aw_dir / "memory.db"
    if g.is_file():
        stores["global"] = g

    for r_name, r_root in repo_paths.items():
        if r_name not in stores:
            p = r_root / ".aw" / "memory.db"
            if p.is_file():
                stores[r_name] = p

    cwd = Path.cwd().resolve()
    if cwd.name not in stores:
        p = cwd / ".aw" / "memory.db"
        if p.is_file():
            stores[cwd.name] = p

    notes: List[Dict[str, Any]] = []
    for store_name, db_path in sorted(stores.items()):
        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            cur = conn.cursor()
            cur.execute("""
                SELECT id, key, rev, kind, scope, session, body, tags, refs,
                       content_hash, source, created_at, expires_at, superseded_by, superseded_at
                FROM memories
                WHERE superseded_by IS NULL
                ORDER BY created_at DESC
            """)
            for row in cur.fetchall():
                key = str(row[1])
                rev = int(row[2])
                kind = str(row[3])
                scope = str(row[4])
                session = str(row[5])
                body = str(row[6])
                tags = [t for t in str(row[7]).split() if t]
                refs = [r for r in str(row[8]).split() if r]
                source = str(row[10])
                created_at = int(row[11])

                if kind == "gotcha":
                    prev_role = "REGRESSION GUARD"
                    prev_desc = "Prevents repeating root-cause bug or edge-case failure"
                elif kind == "decision":
                    prev_role = "ARCHITECTURE INVARIANT"
                    prev_desc = "Enforces structural invariant or boundary constraint"
                elif kind == "fact":
                    prev_role = "EXPLORATION SHORTCUT"
                    prev_desc = "Avoids multi-file grep scans with verified system fact"
                else:
                    prev_role = "HANDOFF CONTEXT"
                    prev_desc = "Preserves active task state across sessions"

                notes.append({
                    "store": store_name,
                    "id": row[0],
                    "key": key,
                    "rev": rev,
                    "kind": kind,
                    "scope": scope,
                    "session": session,
                    "body": body,
                    "tags": tags,
                    "refs": refs,
                    "source": source,
                    "created_at": created_at,
                    "prev_role": prev_role,
                    "prev_desc": prev_desc,
                })
            conn.close()
        except (sqlite3.Error, OSError):
            continue

    return sorted(notes, key=lambda n: n["created_at"], reverse=True)


def collect_reuse_for_tui(repo_paths: Dict[str, Path]) -> List[Dict[str, Any]]:
    """Extract D1-D4 duplication candidates across indexed repositories."""
    repos = dict(repo_paths)
    cwd = Path.cwd().resolve()
    if cwd.name not in repos and (cwd / ".aw" / "index.db").is_file():
        repos[cwd.name] = cwd

    candidates: List[Dict[str, Any]] = []
    for r_name, r_root in sorted(repos.items()):
        db_path = r_root / ".aw" / "index.db"
        if not db_path.is_file():
            continue

        try:
            cmd = ["aw", "--no-journal", "--root", str(r_root), "reuse", "--limit", "20"]
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=3.0)
            output = res.stdout
        except (subprocess.SubprocessError, OSError):
            output = ""

        conn = None
        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            cur = conn.cursor()
        except (sqlite3.Error, OSError):
            cur = None

        lines = output.strip().splitlines()
        i = 0
        while i < len(lines):
            line = lines[i].strip()
            if line.startswith("symbol '"):
                m = re.match(
                    r"symbol '([^']+)' (shares (\d+)% (callee footprint|interface token overlap) with existing|bypasses canonical client|is a pass-through wrapper around existing) '([^']+)' \(\[callers=(\d+)\] in ([^:]+):(\d+)\)",
                    line,
                )
                shared_line = ""
                if i + 1 < len(lines) and lines[i + 1].startswith("  "):
                    shared_line = lines[i + 1].strip()
                    i += 1

                if m:
                    sym = m.group(1)
                    canonical = m.group(5)
                    callers = int(m.group(6))
                    c_file = m.group(7)
                    c_line = int(m.group(8))
                    pct = int(m.group(3)) if m.group(3) else 100

                    if "callee footprint" in line:
                        det = "D1"
                        det_title = "D1 Callee Footprint Overlap"
                        guidance = f"Replace duplicate workflow '{sym}' with canonical '{canonical}' ([callers={callers}])."
                    elif "interface token" in line:
                        det = "D2"
                        det_title = "D2 Interface Token Overlap"
                        guidance = f"Unify parameter structure with canonical '{canonical}' ([callers={callers}]) to avoid twin implementations."
                    elif "bypasses" in line:
                        det = "D3"
                        det_title = "D3 Raw Client Bypass"
                        guidance = f"Route calls in '{sym}' through canonical managed client '{canonical}' ([callers={callers}])."
                    else:
                        det = "D4"
                        det_title = "D4 Redundant Pass-Through Wrapper"
                        guidance = f"Eliminate single-caller wrapper '{sym}' and invoke '{canonical}' ([callers={callers}]) directly."

                    sym_loc = 10
                    sym_file = ""
                    if cur:
                        try:
                            cur.execute(
                                "SELECT file_path, line_start, line_end FROM symbols WHERE qualname = ?1 OR qualname LIKE ?2 LIMIT 1",
                                (sym, "%" + sym),
                            )
                            srow = cur.fetchone()
                            if srow:
                                sym_file = srow[0]
                                sym_loc = max(1, srow[2] - srow[1] + 1)
                        except sqlite3.Error:
                            pass

                    candidates.append({
                        "repo": r_name,
                        "detector": det,
                        "detector_title": det_title,
                        "symbol": sym,
                        "canonical": canonical,
                        "canonical_callers": callers,
                        "canonical_file": c_file,
                        "canonical_line": c_line,
                        "overlap_pct": pct,
                        "shared_evidence": shared_line,
                        "sym_file": sym_file,
                        "loc_saving": sym_loc,
                        "guidance": guidance,
                    })
            i += 1

        if conn:
            conn.close()

    return candidates


class LiveMonitorTUI:
    """Curses-based real-time terminal dashboard for aw."""

    VIEW_STREAM = 0
    VIEW_REUSE = 1
    VIEW_MEMORIES = 2
    VIEW_BREAKDOWN = 3

    def __init__(self, log_path: Path, errors_only: bool = False, repo_filter: str = "ALL"):
        self.log_path = log_path
        self.aw_dir = log_path.parent
        self.errors_only = errors_only
        self.repo_filter = repo_filter
        self.paused = False
        self.current_view = self.VIEW_STREAM

        # Stream data
        self.events: List[Dict[str, Any]] = []
        self.last_pos = 0
        self.total_queries = 0
        self.total_errors = 0
        self.total_warnings = 0
        self.saved_tokens = 0
        self.latencies: List[float] = []
        self.repo_counts: Dict[str, int] = {}
        self.repo_paths: Dict[str, Path] = {}
        self.tool_counts: Dict[str, int] = {}
        self.tool_latencies: Dict[str, List[float]] = {}
        self.last_error: Optional[Dict[str, Any]] = None

        # Cursor & filter state
        self.stream_cursor = 0
        self.memory_cursor = 0
        self.reuse_cursor = 0

        self.memories: List[Dict[str, Any]] = []
        self.last_mem_refresh = 0.0
        self.mem_kind_filter = "ALL"
        self.mem_store_filter = "ALL"

        self.reuse_candidates: List[Dict[str, Any]] = []
        self.last_reuse_refresh = 0.0
        self.reuse_detector_filter = "ALL"
        self.reuse_repo_filter = "ALL"

    def load_initial_history(self, limit: int = 100):
        """Pre-load recent history from usage.log."""
        if not self.log_path.is_file():
            return

        try:
            with open(self.log_path, "r", encoding="utf-8", errors="replace") as f:
                lines = f.readlines()
                for line in lines[-limit:]:
                    line = line.strip()
                    if line:
                        try:
                            entry = json.loads(line)
                            self.process_entry(entry)
                        except Exception:
                            pass
                self.last_pos = f.tell()
        except OSError:
            pass

    def refresh_memories(self, force: bool = False):
        """Periodically refresh active memory notes."""
        now = time.time()
        if force or (now - self.last_mem_refresh > 4.0):
            self.memories = collect_memories_for_tui(self.aw_dir, self.repo_paths)
            self.last_mem_refresh = now

    def refresh_reuse(self, force: bool = False):
        """Periodically refresh anti-reinvention candidates."""
        now = time.time()
        if force or (now - self.last_reuse_refresh > 15.0):
            self.reuse_candidates = collect_reuse_for_tui(self.repo_paths)
            self.last_reuse_refresh = now

    def process_entry(self, entry: Dict[str, Any]):
        """Record live event metrics."""
        self.total_queries += 1
        tool = str(entry.get("tool", "unknown"))
        exit_code = int(entry.get("exit_code", 0))
        repo_name = str(entry.get("repo_name") or "workspace")
        repo_root = entry.get("repo")
        lat_us = entry.get("latency_us")
        shown = int(entry.get("shown", entry.get("result_count", 0)))

        self.tool_counts[tool] = self.tool_counts.get(tool, 0) + 1
        self.repo_counts[repo_name] = self.repo_counts.get(repo_name, 0) + 1
        if repo_root and repo_name not in self.repo_paths:
            self.repo_paths[repo_name] = Path(repo_root)

        if exit_code >= 3:
            self.total_errors += 1
            self.last_error = entry
        elif exit_code in (1, 2):
            self.total_warnings += 1

        if lat_us is not None and lat_us >= 0:
            lat_ms = lat_us / 1000.0
            self.latencies.append(lat_ms)
            self.tool_latencies.setdefault(tool, []).append(lat_ms)

        if exit_code == 0:
            if tool in ("context", "callers", "callees", "path", "impact", "imports"):
                self.saved_tokens += shown * 350 + 100
            elif tool == "search":
                self.saved_tokens += shown * 300 + 100
            elif tool == "reuse":
                self.saved_tokens += shown * 800 + 1200
            elif tool == "symbols":
                self.saved_tokens += shown * 150
            elif tool == "build":
                self.saved_tokens += 500

        self.events.append(entry)
        if len(self.events) > 400:
            self.events.pop(0)

    def poll_new_lines(self):
        """Read any new lines appended to the log file."""
        if self.paused or not self.log_path.is_file():
            return

        try:
            current_size = self.log_path.stat().st_size
            if current_size < self.last_pos:
                self.last_pos = 0

            if current_size > self.last_pos:
                with open(self.log_path, "r", encoding="utf-8", errors="replace") as f:
                    f.seek(self.last_pos)
                    for line in f:
                        line = line.strip()
                        if line:
                            try:
                                entry = json.loads(line)
                                self.process_entry(entry)
                            except Exception:
                                pass
                    self.last_pos = f.tell()
        except OSError:
            pass

    def run(self, stdscr):
        """Main curses event loop."""
        curses.curs_set(0)
        stdscr.timeout(100)

        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)     # Primary Header
        curses.init_pair(2, curses.COLOR_GREEN, -1)    # Success / Healthy
        curses.init_pair(3, curses.COLOR_RED, -1)      # Error / Critical
        curses.init_pair(4, curses.COLOR_YELLOW, -1)   # Warning / Accent
        curses.init_pair(5, curses.COLOR_MAGENTA, -1)  # Tags / Identifiers
        curses.init_pair(6, curses.COLOR_WHITE, curses.COLOR_BLUE)  # Status bar
        curses.init_pair(7, curses.COLOR_BLACK, curses.COLOR_CYAN)  # Selected row highlight

        self.load_initial_history()

        while True:
            self.poll_new_lines()
            self.refresh_memories()
            self.refresh_reuse()
            self.render(stdscr)

            try:
                ch = stdscr.getch()
                if ch in (ord('q'), ord('Q')):
                    break
                elif ch == ord('1'):
                    self.current_view = self.VIEW_STREAM
                elif ch == ord('2'):
                    self.current_view = self.VIEW_REUSE
                    self.refresh_reuse(force=True)
                elif ch == ord('3'):
                    self.current_view = self.VIEW_MEMORIES
                    self.refresh_memories(force=True)
                elif ch == ord('4'):
                    self.current_view = self.VIEW_BREAKDOWN
                elif ch in (ord('p'), ord('P'), ord(' ')):
                    self.paused = not self.paused
                elif ch in (ord('e'), ord('E')):
                    self.errors_only = not self.errors_only
                elif ch in (ord('c'), ord('C')):
                    self.events.clear()
                    self.stream_cursor = 0
                elif ch in (ord('r'), ord('R')):
                    # Cycle repo filter in Stream or Reuse view
                    if self.current_view == self.VIEW_REUSE:
                        repos = ["ALL"] + sorted({c["repo"] for c in self.reuse_candidates})
                        idx = (repos.index(self.reuse_repo_filter) + 1) % len(repos) if self.reuse_repo_filter in repos else 0
                        self.reuse_repo_filter = repos[idx]
                        self.reuse_cursor = 0
                    else:
                        repos = ["ALL"] + sorted(self.repo_counts.keys())
                        idx = (repos.index(self.repo_filter) + 1) % len(repos) if self.repo_filter in repos else 0
                        self.repo_filter = repos[idx]
                        self.stream_cursor = 0
                elif ch in (ord('d'), ord('D')):
                    # Cycle detector filter in Reuse view
                    dets = ["ALL", "D1", "D2", "D3", "D4"]
                    idx = (dets.index(self.reuse_detector_filter) + 1) % len(dets) if self.reuse_detector_filter in dets else 0
                    self.reuse_detector_filter = dets[idx]
                    self.reuse_cursor = 0
                elif ch in (ord('t'), ord('T')):
                    # Cycle kind filter in Memory view
                    kinds = ["ALL", "decision", "gotcha", "fact", "task"]
                    idx = (kinds.index(self.mem_kind_filter) + 1) % len(kinds) if self.mem_kind_filter in kinds else 0
                    self.mem_kind_filter = kinds[idx]
                    self.memory_cursor = 0
                elif ch in (ord('s'), ord('S')):
                    # Cycle store filter in Memory view
                    stores = ["ALL"] + sorted({m["store"] for m in self.memories})
                    idx = (stores.index(self.mem_store_filter) + 1) % len(stores) if self.mem_store_filter in stores else 0
                    self.mem_store_filter = stores[idx]
                    self.memory_cursor = 0
                elif ch in (curses.KEY_UP, ord('k'), ord('K')):
                    if self.current_view == self.VIEW_STREAM:
                        self.stream_cursor = max(0, self.stream_cursor - 1)
                    elif self.current_view == self.VIEW_REUSE:
                        self.reuse_cursor = max(0, self.reuse_cursor - 1)
                    elif self.current_view == self.VIEW_MEMORIES:
                        self.memory_cursor = max(0, self.memory_cursor - 1)
                elif ch in (curses.KEY_DOWN, ord('j'), ord('J')):
                    if self.current_view == self.VIEW_STREAM:
                        self.stream_cursor += 1
                    elif self.current_view == self.VIEW_REUSE:
                        self.reuse_cursor += 1
                    elif self.current_view == self.VIEW_MEMORIES:
                        self.memory_cursor += 1
            except Exception:
                pass

    def render(self, stdscr):
        """Draw active view."""
        height, width = stdscr.getmaxyx()
        stdscr.erase()

        if height < 14 or width < 80:
            stdscr.addstr(0, 0, f"Terminal size {width}x{height} too small. Minimum required: 80x14.")
            stdscr.refresh()
            return

        # 1. Global Navigation Bar (4 Views)
        view_labels = [
            (" [1] Live Stream ", self.current_view == self.VIEW_STREAM),
            (f" [2] Anti-Reinvention ({len(self.reuse_candidates)}) ", self.current_view == self.VIEW_REUSE),
            (f" [3] Memory Inspector ({len(self.memories)}) ", self.current_view == self.VIEW_MEMORIES),
            (" [4] Breakdown & Health ", self.current_view == self.VIEW_BREAKDOWN),
        ]
        x_nav = 0
        for text, active in view_labels:
            attr = curses.color_pair(7) | curses.A_BOLD if active else curses.color_pair(1)
            stdscr.addstr(0, x_nav, text, attr)
            x_nav += len(text) + 1

        live_tag = "[PAUSED]" if self.paused else "[LIVE]"
        live_color = curses.color_pair(4) if self.paused else curses.color_pair(2)
        right_x = max(0, width - len(live_tag) - 1)
        stdscr.addstr(0, right_x, live_tag, live_color | curses.A_BOLD)

        # 2. Executive KPI Header
        reliability = (
            (100.0 * (self.total_queries - self.total_errors) / self.total_queries)
            if self.total_queries > 0
            else 100.0
        )
        p50 = (
            sorted(self.latencies)[len(self.latencies) // 2]
            if self.latencies
            else 0.0
        )
        dollars = self.saved_tokens * 0.000003
        mem_count = len(self.memories)
        reuse_count = len(self.reuse_candidates)

        kpi_line = (
            f"Queries: {self.total_queries} | "
            f"Success: {reliability:.1f}% ({self.total_errors} err) | "
            f"p50: {p50:.1f}ms | "
            f"Duplicates: {reuse_count} | "
            f"Memories: {mem_count} | "
            f"Saved: ~${dollars:.2f}"
        )
        stdscr.addstr(1, 0, kpi_line[:width - 1], curses.A_NORMAL)

        sep = "─" * (width - 1)
        stdscr.addstr(2, 0, sep, curses.A_DIM)

        # Render specific view
        if self.current_view == self.VIEW_STREAM:
            self.render_stream_view(stdscr, height, width)
        elif self.current_view == self.VIEW_REUSE:
            self.render_reuse_view(stdscr, height, width)
        elif self.current_view == self.VIEW_MEMORIES:
            self.render_memories_view(stdscr, height, width)
        else:
            self.render_breakdown_view(stdscr, height, width)

        # Global Bottom Status & Shortcut Bar
        self.render_footer(stdscr, height, width)
        stdscr.refresh()

    def render_stream_view(self, stdscr, height: int, width: int):
        """Render Live Stream View with master query table and detail inspector."""
        mode_str = "CRITICAL ERRORS ONLY" if self.errors_only else "ALL CALLS"
        filter_text = f"Filter: Repo=[{self.repo_filter}] | Mode=[{mode_str}] | [r] Cycle Repo  [e] Toggle Errors"
        stdscr.addstr(3, 0, filter_text[:width - 1], curses.color_pair(4))

        col_hdr = f"{'TIME':<9} {'REPO':<14} {'TOOL':<12} {'LATENCY':<10} {'STATUS':<9} ARGUMENTS"
        stdscr.addstr(4, 0, col_hdr[:width - 1], curses.A_BOLD)
        stdscr.addstr(5, 0, "─" * (width - 1), curses.A_DIM)

        filtered = [
            e for e in self.events
            if (not self.errors_only or int(e.get("exit_code", 0)) >= 3)
            and (self.repo_filter == "ALL" or e.get("repo_name") == self.repo_filter)
        ]

        table_rows = max(4, (height - 11) // 2)
        if not filtered:
            stdscr.addstr(6, 0, "No query events matching current filter criteria.", curses.color_pair(4))
            return

        if self.stream_cursor >= len(filtered):
            self.stream_cursor = len(filtered) - 1
        if self.stream_cursor < 0:
            self.stream_cursor = 0

        start_idx = max(0, min(self.stream_cursor - table_rows // 2, len(filtered) - table_rows))
        window_events = filtered[start_idx : start_idx + table_rows]

        for i, e in enumerate(window_events):
            row_idx = start_idx + i
            y = 6 + i
            is_selected = (row_idx == self.stream_cursor)

            ts = e.get("ts", 0)
            time_str = time.strftime("%H:%M:%S", time.localtime(ts)) if ts else "-"
            r_name = str(e.get("repo_name") or "workspace")[:13]
            tool = str(e.get("tool", "-"))[:11]
            lat_us = e.get("latency_us")
            lat_str = f"{lat_us / 1000.0:.1f}ms" if lat_us is not None else "-"
            exit_code = int(e.get("exit_code", 0))

            if exit_code == 0:
                status_str = "OK"
                status_color = curses.color_pair(2)
            elif exit_code == 1:
                status_str = "EMPTY"
                status_color = curses.color_pair(4)
            elif exit_code == 2:
                status_str = "AMBIG"
                status_color = curses.color_pair(5)
            else:
                status_str = f"ERR {exit_code}"
                status_color = curses.color_pair(3) | curses.A_BOLD

            args_raw = json.dumps(e.get("args", {}), ensure_ascii=False)
            max_args_len = max(10, width - 60)
            args_str = args_raw[:max_args_len]

            row_prefix = f"{time_str:<9} {r_name:<14} {tool:<12} {lat_str:<10} "
            if is_selected:
                full_row = f"{row_prefix}{status_str:<9} {args_str}".ljust(width - 1)
                stdscr.addstr(y, 0, full_row[:width - 1], curses.color_pair(7) | curses.A_BOLD)
            else:
                stdscr.addstr(y, 0, row_prefix)
                stdscr.addstr(y, len(row_prefix), f"{status_str:<9}", status_color)
                stdscr.addstr(y, len(row_prefix) + 9, f" {args_str}")

        # Detail Inspector Pane
        split_y = 6 + table_rows
        stdscr.addstr(split_y, 0, "─" * (width - 1), curses.A_DIM)
        sel_entry = filtered[self.stream_cursor]
        hdr_info = f"EVENT INSPECTOR [{self.stream_cursor + 1}/{len(filtered)}]: {sel_entry.get('tool')} in {sel_entry.get('repo_name') or 'workspace'}"
        stdscr.addstr(split_y + 1, 0, hdr_info[:width - 1], curses.color_pair(1) | curses.A_BOLD)

        shown = sel_entry.get("shown", sel_entry.get("result_count", 0))
        lat = sel_entry.get("latency_us")
        lat_text = f"{lat / 1000.0:.2f} ms ({lat} µs)" if lat else "N/A"
        diag = f"Exit: {sel_entry.get('exit_code')} | Items: {shown} | Latency: {lat_text} | Worktree: {sel_entry.get('worktree', False)}"
        stdscr.addstr(split_y + 2, 0, diag[:width - 1], curses.A_DIM)

        stdscr.addstr(split_y + 3, 0, "Full Command Arguments:", curses.A_UNDERLINE)
        args_pretty = json.dumps(sel_entry.get("args", {}), indent=2, ensure_ascii=False)
        for idx, line in enumerate(args_pretty.splitlines()[: height - split_y - 5]):
            stdscr.addstr(split_y + 4 + idx, 2, line[:width - 3])

    def render_reuse_view(self, stdscr, height: int, width: int):
        """Render Dedicated Anti-Reinvention Inspector View."""
        filter_text = f"Filter: Repo=[{self.reuse_repo_filter}] | Detector=[{self.reuse_detector_filter}] | [d] Cycle Detector  [r] Cycle Repo  [j/k] Navigate"
        stdscr.addstr(3, 0, filter_text[:width - 1], curses.color_pair(4))

        col_hdr = f"{'REPO':<12} {'DET':<5} {'OVERLAP':<9} {'SYMBOL -> CANONICAL TARGET':<46} {'CALLERS':<9} SAVING"
        stdscr.addstr(4, 0, col_hdr[:width - 1], curses.A_BOLD)
        stdscr.addstr(5, 0, "─" * (width - 1), curses.A_DIM)

        filtered = [
            c for c in self.reuse_candidates
            if (self.reuse_repo_filter == "ALL" or c["repo"] == self.reuse_repo_filter)
            and (self.reuse_detector_filter == "ALL" or c["detector"] == self.reuse_detector_filter)
        ]

        table_rows = max(4, (height - 12) // 2)
        if not filtered:
            stdscr.addstr(6, 0, "Zero duplication candidates match criteria. Codebase clean of duplicate helpers.", curses.color_pair(2))
            return

        if self.reuse_cursor >= len(filtered):
            self.reuse_cursor = len(filtered) - 1
        if self.reuse_cursor < 0:
            self.reuse_cursor = 0

        start_idx = max(0, min(self.reuse_cursor - table_rows // 2, len(filtered) - table_rows))
        window = filtered[start_idx : start_idx + table_rows]

        for i, c in enumerate(window):
            row_idx = start_idx + i
            y = 6 + i
            is_selected = (row_idx == self.reuse_cursor)

            r_name = c["repo"][:11]
            det = c["detector"][:4]
            pct_str = f"{c['overlap_pct']}%"
            pair_str = f"{c['symbol']} -> {c['canonical']}"[:45]
            callers_str = f"[c={c['canonical_callers']}]"
            saving_str = f"-{c['loc_saving']} LOC"

            det_color = curses.color_pair(4) if det in ("D1", "D2") else curses.color_pair(1)

            if is_selected:
                row_str = f"{r_name:<12} {det:<5} {pct_str:<9} {pair_str:<46} {callers_str:<9} {saving_str}".ljust(width - 1)
                stdscr.addstr(y, 0, row_str[:width - 1], curses.color_pair(7) | curses.A_BOLD)
            else:
                stdscr.addstr(y, 0, f"{r_name:<12} ")
                stdscr.addstr(y, 13, f"{det:<5}", det_color | curses.A_BOLD)
                stdscr.addstr(y, 19, f"{pct_str:<9} {pair_str:<46} ")
                stdscr.addstr(y, 75, f"{callers_str:<9}", curses.color_pair(2))
                stdscr.addstr(y, 85, f"{saving_str}")

        # Bottom Pane: Prevention & Consolidation Dossier
        split_y = 6 + table_rows
        stdscr.addstr(split_y, 0, "─" * (width - 1), curses.A_DIM)
        sel = filtered[self.reuse_cursor]

        dossier_hdr = f"ANTI-REINVENTION DOSSIER [{self.reuse_cursor + 1}/{len(filtered)}]: {sel['detector_title']} in {sel['repo']}"
        stdscr.addstr(split_y + 1, 0, dossier_hdr[:width - 1], curses.color_pair(1) | curses.A_BOLD)

        meta_line = f"Duplicate: {sel['symbol']}  -->  Canonical: {sel['canonical']} ([callers={sel['canonical_callers']}] in {sel['canonical_file']}:{sel['canonical_line']})"
        stdscr.addstr(split_y + 2, 0, meta_line[:width - 1], curses.color_pair(4))

        if sel.get("shared_evidence"):
            stdscr.addstr(split_y + 3, 0, f"Evidence: {sel['shared_evidence']}"[:width - 1], curses.A_DIM)

        stdscr.addstr(split_y + 4, 0, "Consolidation Guidance & Savings:", curses.A_UNDERLINE)
        guidance_text = f"{sel['guidance']} Saves ~{sel['loc_saving']} lines of redundant code."
        wrapped_guidance = textwrap.wrap(guidance_text, width=max(40, width - 4))
        for idx, gline in enumerate(wrapped_guidance[: height - split_y - 6]):
            stdscr.addstr(split_y + 5 + idx, 2, gline[:width - 3])

    def render_memories_view(self, stdscr, height: int, width: int):
        """Render Memory Inspector View with master table and detail dossier."""
        filter_text = f"Filter: Store=[{self.mem_store_filter}] | Kind=[{self.mem_kind_filter}] | [s] Cycle Store  [t] Cycle Kind  [j/k] Navigate"
        stdscr.addstr(3, 0, filter_text[:width - 1], curses.color_pair(4))

        col_hdr = f"{'STORE':<12} {'KIND':<10} {'KEY':<24} {'REV':<5} {'TAGS':<20} AGE"
        stdscr.addstr(4, 0, col_hdr[:width - 1], curses.A_BOLD)
        stdscr.addstr(5, 0, "─" * (width - 1), curses.A_DIM)

        filtered = [
            m for m in self.memories
            if (self.mem_store_filter == "ALL" or m["store"] == self.mem_store_filter)
            and (self.mem_kind_filter == "ALL" or m["kind"] == self.mem_kind_filter)
        ]

        table_rows = max(4, (height - 12) // 2)
        if not filtered:
            stdscr.addstr(6, 0, "No memory notes matching current filter criteria.", curses.color_pair(4))
            return

        if self.memory_cursor >= len(filtered):
            self.memory_cursor = len(filtered) - 1
        if self.memory_cursor < 0:
            self.memory_cursor = 0

        start_idx = max(0, min(self.memory_cursor - table_rows // 2, len(filtered) - table_rows))
        window_memories = filtered[start_idx : start_idx + table_rows]

        now = int(time.time())
        for i, m in enumerate(window_memories):
            row_idx = start_idx + i
            y = 6 + i
            is_selected = (row_idx == self.memory_cursor)

            store = m["store"][:11]
            kind = m["kind"].upper()[:9]
            key = m["key"][:23]
            rev = f"r{m['rev']}"[:4]
            tags_str = (" ".join(f"#{t}" for t in m["tags"]))[:19]
            age_str = format_age_secs(now - m["created_at"])

            kind_color = curses.color_pair(1)
            if kind == "DECISION":
                kind_color = curses.color_pair(1)
            elif kind == "GOTCHA":
                kind_color = curses.color_pair(4)
            elif kind == "FACT":
                kind_color = curses.color_pair(2)
            elif kind == "TASK":
                kind_color = curses.color_pair(5)

            if is_selected:
                full_row = f"{store:<12} {kind:<10} {key:<24} {rev:<5} {tags_str:<20} {age_str}".ljust(width - 1)
                stdscr.addstr(y, 0, full_row[:width - 1], curses.color_pair(7) | curses.A_BOLD)
            else:
                stdscr.addstr(y, 0, f"{store:<12} ")
                stdscr.addstr(y, 13, f"{kind:<10}", kind_color | curses.A_BOLD)
                stdscr.addstr(y, 24, f"{key:<24} {rev:<5} ")
                stdscr.addstr(y, 54, f"{tags_str:<20}", curses.color_pair(5))
                stdscr.addstr(y, 75, f"{age_str}")

        # Memory Dossier Inspector Pane
        split_y = 6 + table_rows
        stdscr.addstr(split_y, 0, "─" * (width - 1), curses.A_DIM)
        sel = filtered[self.memory_cursor]

        dossier_title = f"MEMORY DOSSIER [{self.memory_cursor + 1}/{len(filtered)}]: {sel['key']} (rev {sel['rev']}) [{sel['kind'].upper()}]"
        stdscr.addstr(split_y + 1, 0, dossier_title[:width - 1], curses.color_pair(1) | curses.A_BOLD)

        meta_str = f"Store: {sel['store']} | Scope: {sel['scope']} | Role: [{sel.get('prev_role', 'GUARD')}]"
        stdscr.addstr(split_y + 2, 0, meta_str[:width - 1], curses.color_pair(2))

        tags_display = " ".join(f"#{t}" for t in sel["tags"]) if sel["tags"] else "none"
        refs_display = ", ".join(sel["refs"]) if sel["refs"] else "none"
        stdscr.addstr(split_y + 3, 0, f"Tags: {tags_display}  |  Code Refs: {refs_display}"[:width - 1], curses.color_pair(4))

        stdscr.addstr(split_y + 4, 0, "Memory Body & Prevention Role:", curses.A_UNDERLINE)
        body_lines = textwrap.wrap(sel["body"], width=max(40, width - 4))
        max_body_lines = height - split_y - 6
        for idx, line in enumerate(body_lines[:max_body_lines]):
            stdscr.addstr(split_y + 5 + idx, 2, line[:width - 3])

    def render_breakdown_view(self, stdscr, height: int, width: int):
        """Render Aggregate Breakdown and Telemetry Health view."""
        hdr = "AGGREGATE BREAKDOWN & TELEMETRY HEALTH"
        stdscr.addstr(3, 0, hdr, curses.color_pair(1) | curses.A_BOLD)
        stdscr.addstr(4, 0, "─" * (width - 1), curses.A_DIM)

        col_w = max(35, (width - 4) // 2)

        # Left Column: Tool Invocations
        stdscr.addstr(5, 0, "TOOL USAGE & LATENCY PROFILE", curses.A_BOLD)
        stdscr.addstr(6, 0, f"{'TOOL':<14} {'CALLS':<8} {'SHARE':<7} {'AVG LATENCY'}", curses.A_DIM)

        sorted_tools = sorted(self.tool_counts.items(), key=lambda x: x[1], reverse=True)
        total_tool_calls = sum(self.tool_counts.values()) or 1
        y = 7
        for tool, count in sorted_tools[: max(5, height - 16)]:
            share = (100.0 * count) / total_tool_calls
            lats = self.tool_latencies.get(tool, [])
            avg_lat = (sum(lats) / len(lats)) if lats else 0.0
            row_str = f"{tool:<14} {count:<8} {share:>5.1f}%  {avg_lat:>6.2f} ms"
            stdscr.addstr(y, 0, row_str[:col_w])
            y += 1

        # Right Column: Repository Distribution & Error Profile
        rx = col_w + 3
        stdscr.addstr(5, rx, "REPOSITORY DISTRIBUTION", curses.A_BOLD)
        stdscr.addstr(6, rx, f"{'REPOSITORY':<20} {'CALLS':<8} {'SHARE'}", curses.A_DIM)

        sorted_repos = sorted(self.repo_counts.items(), key=lambda x: x[1], reverse=True)
        total_repo_calls = sum(self.repo_counts.values()) or 1
        ry = 7
        for repo, count in sorted_repos[: max(5, height - 16)]:
            share = (100.0 * count) / total_repo_calls
            row_str = f"{repo[:19]:<20} {count:<8} {share:>5.1f}%"
            stdscr.addstr(ry, rx, row_str[:width - rx - 1])
            ry += 1

        # Error / Notice Health Card
        health_y = max(y, ry) + 1
        stdscr.addstr(health_y, 0, "─" * (width - 1), curses.A_DIM)
        health_y += 1
        if self.last_error and self.total_errors > 0:
            err_ts = time.strftime("%H:%M:%S", time.localtime(self.last_error.get("ts", 0)))
            err_tool = self.last_error.get("tool")
            err_repo = self.last_error.get("repo_name")
            err_code = self.last_error.get("exit_code")
            alert = f"[ALERT] Last Critical Failure at {err_ts}: {err_tool} in {err_repo} (exit {err_code})"
            stdscr.addstr(health_y, 0, alert[:width - 1], curses.color_pair(3) | curses.A_BOLD)
        else:
            stdscr.addstr(health_y, 0, "[HEALTHY] All operations nominal. Zero critical errors.", curses.color_pair(2) | curses.A_BOLD)

    def render_footer(self, stdscr, height: int, width: int):
        """Render sticky bottom status bar."""
        if self.current_view == self.VIEW_STREAM:
            shortcuts = " [1-4] Views  [j/k] Navigate  [r] Repo  [e] Errors  [p] Pause  [c] Clear  [q] Quit "
        elif self.current_view == self.VIEW_REUSE:
            shortcuts = " [1-4] Views  [j/k] Navigate  [d] Detector  [r] Repo  [p] Pause  [q] Quit "
        elif self.current_view == self.VIEW_MEMORIES:
            shortcuts = " [1-4] Views  [j/k] Navigate  [s] Store  [t] Kind  [q] Quit "
        else:
            shortcuts = " [1-4] Views  [p] Pause  [q] Quit "

        stdscr.addstr(height - 1, 0, shortcuts.ljust(width - 1)[:width - 1], curses.color_pair(6))


def main():
    parser = argparse.ArgumentParser(
        description="Real-time live monitor for aw (agent-weave) across repos and worktrees."
    )
    parser.add_argument(
        "--web",
        nargs="?",
        const=7890,
        type=int,
        default=None,
        help="Start live web dashboard (SSE streaming) on specified port (default: 7890)",
    )
    parser.add_argument(
        "--errors-only",
        action="store_true",
        help="Launch TUI filtering for errors only",
    )
    parser.add_argument(
        "--repo",
        type=str,
        default="ALL",
        help="Filter live monitor to specific repository name",
    )
    parser.add_argument(
        "--no-open",
        action="store_true",
        help="Do not automatically open the browser when starting --web server",
    )
    args = parser.parse_args()

    aw_dir = resolve_global_aw_dir()
    log_path = aw_dir / "usage.log"

    if args.web is not None:
        script_dir = Path(__file__).resolve().parent
        render_py = script_dir / "../tests/scripts/render_dashboard.py"
        cmd = [
            sys.executable,
            "-I",
            str(render_py),
            "--global",
            "--serve",
            str(args.web),
        ]
        if not args.no_open:
            cmd.append("--open")
        try:
            subprocess.run(cmd)
        except KeyboardInterrupt:
            pass
        return

    # Default: Interactive TUI
    app = LiveMonitorTUI(log_path, errors_only=args.errors_only, repo_filter=args.repo)
    try:
        curses.wrapper(app.run)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
