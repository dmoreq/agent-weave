#!/usr/bin/env bash
# Native Rust Dashboard launcher for aw (agent-weave).
# Zero Python requirement.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if command -v aw >/dev/null 2>&1; then
  exec aw dashboard --global "$@"
else
  exec cargo run --manifest-path "$REPO_ROOT/Cargo.toml" --quiet -- dashboard --global "$@"
fi
