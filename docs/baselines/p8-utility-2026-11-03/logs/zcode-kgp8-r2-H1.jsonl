{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0_12683022036bebda","type":"tool_result","content":"\"\"\"Domain exception hierarchy for VIHAP (Vietnamese Hierarchical Address Parser).\"\"\"\n\nfrom __future__ import annotations\n\n\nclass VihapError(Exception):\n    \"\"\"Base exception for all VIHAP domain errors.\"\"\"\n\n\nclass VihapConfigError(VihapError, ValueError):\n    \"\"\"Raised when parser configuration options are invalid or conflicting.\"\"\"\n\n\nclass VihapArtifactError(VihapError, FileNotFoundError):\n    \"\"\"Raised when required ontology or knowledge database artifacts are missing or corrupted.\"\"\"\n\n\nclass VihapParsingError(VihapError):\n    \"\"\"Base exception for address parsing and structural decomposition failures.\"\"\"\n\n\nclass AdminResolutionError(VihapParsingError):\n    \"\"\"Raised when administrative boundaries cannot be resolved or contain unresolvable contradictions.\"\"\"\n\n    def __init__(\n        self,\n        message: str,\n        raw_address: str | None = None,\n        candidate_admin: dict[str, str | None] | None = None,\n    ) -> None:\n        super().__init__(message)\n        self.raw_address = raw_address\n        self.candidate_admin = candidate_admin or {}\n\n\nclass InvalidAddressFormatError(VihapParsingError, ValueError):\n    \"\"\"Raised when an address input cannot be parsed due to invalid format or unsupported schema.\"\"\"\n\n    def __init__(self, message: str, raw_address: str | None = None) -> None:\n        super().__init__(message)\n        self.raw_address = raw_address\n\n\nclass VihapScoringError(VihapError, ValueError):\n    \"\"\"Raised when scoring evaluation fails due to incompatible inputs or dimensionality mismatch.\"\"\"\n\n\n__all__ = [\n    \"VihapError\",\n    \"VihapConfigError\",\n    \"VihapArtifactError\",\n    \"VihapParsingError\",\n    \"AdminResolutionError\",\n    \"InvalidAddressFormatError\",\n    \"VihapScoringError\",\n]"}]},"parent_tool_use_id":null,"session_id":"sess_a3e91409-b7d8-41ec-9d3e-29f7fb515680","uuid":"71e3b112-f25f-43f9-a08e-2c447e73ee94","timestamp":"2026-11-03T03:29:03.450Z"}
