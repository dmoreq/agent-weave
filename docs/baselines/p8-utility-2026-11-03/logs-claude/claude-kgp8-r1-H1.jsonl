{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_4vEBIMpPpZpuHWNPU6ve0154","type":"tool_result","content":"1\t\"\"\"Domain exception hierarchy for VIHAP (Vietnamese Hierarchical Address Parser).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\t\n6\tclass VihapError(Exception):\n7\t    \"\"\"Base exception for all VIHAP domain errors.\"\"\"\n8\t\n9\t\n10\tclass VihapConfigError(VihapError, ValueError):\n11\t    \"\"\"Raised when parser configuration options are invalid or conflicting.\"\"\"\n12\t\n13\t\n14\tclass VihapArtifactError(VihapError, FileNotFoundError):\n15\t    \"\"\"Raised when required ontology or knowledge database artifacts are missing or corrupted.\"\"\"\n16\t\n17\t\n18\tclass VihapParsingError(VihapError):\n19\t    \"\"\"Base exception for address parsing and structural decomposition failures.\"\"\"\n20\t\n21\t\n22\tclass AdminResolutionError(VihapParsingError):\n23\t    \"\"\"Raised when administrative boundaries cannot be resolved or contain unresolvable contradictions.\"\"\"\n24\t\n25\t    def __init__(\n26\t        self,\n27\t        message: str,\n28\t        raw_address: str | None = None,\n29\t        candidate_admin: dict[str, str | None] | None = None,\n30\t    ) -> None:\n31\t        super().__init__(message)\n32\t        self.raw_address = raw_address\n33\t        self.candidate_admin = candidate_admin or {}\n34\t\n35\t\n36\tclass InvalidAddressFormatError(VihapParsingError, ValueError):\n37\t    \"\"\"Raised when an address input cannot be parsed due to invalid format or unsupported schema.\"\"\"\n38\t\n39\t    def __init__(self, message: str, raw_address: str | None = None) -> None:\n40\t        super().__init__(message)\n41\t        self.raw_address = raw_address\n42\t\n43\t\n44\tclass VihapScoringError(VihapError, ValueError):\n45\t    \"\"\"Raised when scoring evaluation fails due to incompatible inputs or dimensionality mismatch.\"\"\"\n46\t\n47\t\n48\t__all__ = [\n49\t    \"VihapError\",\n50\t    \"VihapConfigError\",\n51\t    \"VihapArtifactError\",\n52\t    \"VihapParsingError\",\n53\t    \"AdminResolutionError\",\n54\t    \"InvalidAddressFormatError\",\n55\t    \"VihapScoringError\",\n56\t]\n57\t"}]},"parent_tool_use_id":null,"session_id":"f20a3966-5984-4e56-a89c-49c4d744f27a","uuid":"63f30840-a333-4dbb-bda8-ff9703ed4ce1","timestamp":"2026-11-03T12:26:18.971Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/p8-utility-corpus-2026-11-03/vihap/vihap/exceptions.py","content":"\"\"\"Domain exception hierarchy for VIHAP (Vietnamese Hierarchical Address Parser).\"\"\"\n\nfrom __future__ import annotations\n\n\nclass VihapError(Exception):\n    \"\"\"Base exception for all VIHAP domain errors.\"\"\"\n\n\nclass VihapConfigError(VihapError, ValueError):\n    \"\"\"Raised when parser configuration options are invalid or conflicting.\"\"\"\n\n\nclass VihapArtifactError(VihapError, FileNotFoundError):\n    \"\"\"Raised when required ontology or knowledge database artifacts are missing or corrupted.\"\"\"\n\n\nclass VihapParsingError(VihapError):\n    \"\"\"Base exception for address parsing and structural decomposition failures.\"\"\"\n\n\nclass AdminResolutionError(VihapParsingError):\n    \"\"\"Raised when administrative boundaries cannot be resolved or contain unresolvable contradictions.\"\"\"\n\n    def __init__(\n        self,\n        message: str,\n        raw_address: str | None = None,\n        candidate_admin: dict[str, str | None] | None = None,\n    ) -> None:\n        super().__init__(message)\n        self.raw_address = raw_address\n        self.candidate_admin = candidate_admin or {}\n\n\nclass InvalidAddressFormatError(VihapParsingError, ValueError):\n    \"\"\"Raised when an address input cannot be parsed due to invalid format or unsupported schema.\"\"\"\n\n    def __init__(self, message: str, raw_address: str | None = None) -> None:\n        super().__init__(message)\n        self.raw_address = raw_address\n\n\nclass VihapScoringError(VihapError, ValueError):\n    \"\"\"Raised when scoring evaluation fails due to incompatible inputs or dimensionality mismatch.\"\"\"\n\n\n__all__ = [\n    \"VihapError\",\n    \"VihapConfigError\",\n    \"VihapArtifactError\",\n    \"VihapParsingError\",\n    \"AdminResolutionError\",\n    \"InvalidAddressFormatError\",\n    \"VihapScoringError\",\n]\n","numLines":57,"startLine":1,"totalLines":57}},"tool_result_meta":[{"id":"call_00_4vEBIMpPpZpuHWNPU6ve0154","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
