{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_yguvhuXEHScT6ShGuJMV1815","type":"tool_result","content":"1\t\"\"\"Unit tests verifying centralized grammar patterns and cleaners.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom vihap.cleaners import exact_text_key\n6\tfrom vihap.grammar import (\n7\t    COMMERCIAL_CATEGORY_TOKENS,\n8\t    CONVENIENCE_CHAIN_PATTERN,\n9\t    EXPLICIT_GATE_PATTERN,\n10\t    HEALTHCARE_FACILITY_PREFIXES,\n11\t    HOUSE_NUMBER_IN_TEXT_RE,\n12\t    MILITARY_AND_DISTRICT_MASK_PATTERN,\n13\t    PREFIX_GATE_PATTERN,\n14\t    PREFIX_SUBUNIT_PATTERN,\n15\t    SPURIOUS_TRANSPORT_PATTERN,\n16\t)\n17\t\n18\t\n19\tdef test_exact_text_key() -> None:\n20\t    assert exact_text_key(\"Bệnh Viện Bạch Mai - Cổng 1\") == (\n21\t        \"benh\",\n22\t        \"vien\",\n23\t        \"bach\",\n24\t        \"mai\",\n25\t        \"cong\",\n26\t        \"1\",\n27\t    )\n28\t    assert exact_text_key(\"7-Eleven_Nguyễn Huệ\") == (\"7\", \"eleven\", \"nguyen\", \"hue\")\n29\t    assert exact_text_key(\"\") == ()\n30\t    assert exact_text_key(None) == ()\n31\t\n32\t\n33\tdef test_centralized_gate_patterns() -> None:\n34\t    # Explicit gate pattern\n35\t    assert EXPLICIT_GATE_PATTERN.search(\"Cổng số 1\")\n36\t    assert EXPLICIT_GATE_PATTERN.search(\"Cổng Cấp Cứu\")\n37\t    assert EXPLICIT_GATE_PATTERN.search(\"Gate #2\")\n38\t    assert not EXPLICIT_GATE_PATTERN.search(\"Công trường Mê Linh\")\n39\t\n40\t    # Prefix gate pattern"}]},"parent_tool_use_id":null,"session_id":"1c34ac87-c0df-4e07-b035-f24dc4e0fee5","uuid":"3efea5fc-e845-4379-bb1e-05e7d1653c82","timestamp":"2026-11-03T12:25:10.779Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/p8-utility-corpus-2026-11-03/vihap/tests/test_centralized_grammar_patterns.py","content":"\"\"\"Unit tests verifying centralized grammar patterns and cleaners.\"\"\"\n\nfrom __future__ import annotations\n\nfrom vihap.cleaners import exact_text_key\nfrom vihap.grammar import (\n    COMMERCIAL_CATEGORY_TOKENS,\n    CONVENIENCE_CHAIN_PATTERN,\n    EXPLICIT_GATE_PATTERN,\n    HEALTHCARE_FACILITY_PREFIXES,\n    HOUSE_NUMBER_IN_TEXT_RE,\n    MILITARY_AND_DISTRICT_MASK_PATTERN,\n    PREFIX_GATE_PATTERN,\n    PREFIX_SUBUNIT_PATTERN,\n    SPURIOUS_TRANSPORT_PATTERN,\n)\n\n\ndef test_exact_text_key() -> None:\n    assert exact_text_key(\"Bệnh Viện Bạch Mai - Cổng 1\") == (\n        \"benh\",\n        \"vien\",\n        \"bach\",\n        \"mai\",\n        \"cong\",\n        \"1\",\n    )\n    assert exact_text_key(\"7-Eleven_Nguyễn Huệ\") == (\"7\", \"eleven\", \"nguyen\", \"hue\")\n    assert exact_text_key(\"\") == ()\n    assert exact_text_key(None) == ()\n\n\ndef test_centralized_gate_patterns() -> None:\n    # Explicit gate pattern\n    assert EXPLICIT_GATE_PATTERN.search(\"Cổng số 1\")\n    assert EXPLICIT_GATE_PATTERN.search(\"Cổng Cấp Cứu\")\n    assert EXPLICIT_GATE_PATTERN.search(\"Gate #2\")\n    assert not EXPLICIT_GATE_PATTERN.search(\"Công trường Mê Linh\")\n\n    # Prefix gate pattern","numLines":40,"startLine":1,"totalLines":78}},"tool_result_meta":[{"id":"call_00_yguvhuXEHScT6ShGuJMV1815","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
