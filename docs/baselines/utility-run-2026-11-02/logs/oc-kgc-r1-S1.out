 else if ch.is_alphanumeric() {\n316:             if ch.is_uppercase() && prev_lower {\n317:                 out.push(' ');\n318:             }\n319:             out.push(ch.to_ascii_lowercase());\n320:             prev_lower = ch.is_lowercase();\n321:         } else {\n322:             out.push(' ');\n323:             prev_lower = false;\n324:         }\n325:     }\n326:     out\n327: }\n328: \n329: /// Dotted identifier chain for identifier/attribute nodes: `a.b.c` -> [a, b, c].\n330: /// Unwraps `type` wrapper nodes (annotations). Rust path keywords (`crate`,\n331: /// `self`, `super`) join the chain as plain segments.\n332: fn dotted_chain(node: Node<'_>, src: &[u8]) -> Option<Vec<String>> {\n333:     match node.kind() {\n334:         \"identifier\" | \"this\" | \"super\" | \"crate\" => Some(vec![text(node, src)]),\n335:         \"attribute\" => {\n336:             let obj = node.child_by_field_name(\"object\")?;\n337:             let attr = node.child_by_field_name(\"attribute\")?;\n338:             let mut chain = dotted_chain(obj, src)?;\n339:             chain.push(text(attr, src));\n340:             Some(chain)\n341:         }\n342:         // Rust scoped_identifier: a::b::c (fields path + name).\n343:         \"scoped_identifier\" => {\n344:             let mut chain = Vec::new();\n345:             if let Some(path) = node.child_by_field_name(\"path\") {\n346:                 if let Some(mut sub) = dotted_chain(path, src) {\n347:                     chain.append(&mut sub);\n348:                 }\n349:             }\n[Output truncated. Continue reading with offset: 350]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /private/tmp/utility-corpus-2026-11-02/kg/src/extract.rs, lines 285-349\n285: /// One-line signature (Amendment 12a): first line of the node's text,\n286: /// trimmed, hard cap 160 chars. Never spans the body: capture stops at the\n287: /// first newline, so the stored text is a header frag