{"type":"tool_use","timestamp":1793606894677,"sessionID":"ses_util_oc_kgc_r1_F1","part":{"partID":"prt_19b4d4009001P18xcC7o5puI2R","sessionID":"ses_util_oc_kgc_r1_F1","messageID":"msg_19b4d2e6f001i61D3Wte6F60rV","type":"tool","id":"call_0ef67e1a6f8040b4adab537f9ab90bab","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '35,60p;150,175p;265,360p' /tmp/prosev-new/vihap/matching/similarity.py","timeout":120000},"output":"from ..cleaners.query_cleaner import (\n    canonicalize_lexical_token,\n    title_norm_for,\n)\nfrom ..cleaners.text_utils import strip_street_or_alley_prefix, word_tokens\nfrom ..cleaners.unicode import normalize_ascii\nfrom ..constants import STREET_PREFIX_RE\nfrom ..grammar.categories import GENERIC_POI_QUALIFIERS, PUDO_GATE_QUALIFIERS\nfrom ..grammar.matching import (\n    ALPHA_SUFFIX_RE,\n    DIGIT_ALPHANUM_TOKEN_RE,\n    DUONG_SO_PREFIX_RE,\n    LEADING_ZERO_RE,\n)\nfrom ..grammar.patterns import build_substring_boundary_pattern\nfrom ..grammar.thoroughfare import DIGIT_MATCH_RE, NON_DIGIT_RE, STREET_QUALIFIERS\nfrom ..grammar.vocabulary import GENERIC_MALL_TOKENS\nfrom ..parsers.alley import normalize_house_number_canonical\n\n_NON_DILUTING_QUALIFIERS: Final[frozenset[str]] = (\n    STREET_QUALIFIERS\n    | PUDO_GATE_QUALIFIERS\n    | GENERIC_POI_QUALIFIERS\n    | GENERIC_MALL_TOKENS\n    | frozenset({\"cafe\", \"coffee\", \"quan\", \"tiem\"})\n)\n    \"\"\"Check if shorter string is a word-boundary delimited substring of longer.\"\"\"\n    tokens = shorter.split()\n    if len(tokens) >= 2 or len(shorter) >= 8:\n        if build_substring_boundary_pattern(shorter).search(longer):\n            return True\n    return False\n\n\ndef evaluate_street_similarity(\n    name_a: str | None,\n    name_b: str | None,\n    threshold: float = 0.82,\n) -> float:\n    \"\"\"Compute street name similarity incorporating prefix stripping, digit lock, and word boundaries.\n\n    Parameters\n    ----------\n    name_a : str or None\n        First street name (e.g., declared street).\n    name_b : str or None\n        Second street name (e.g., candidate OSM road name).\n    threshold : float, default=0.82\n        Decision threshold for near-miss floor penalty.\n\n    Returns\n    -------\n\n\ndef pairwise_address_similarity(\n    X: Sequence[str],\n    Y: Sequence[str] | None = None,\n    *,\n    metric: Literal[\"hybrid\", \"token\", \"levenshtein\", \"street\"] | str = \"hybrid\",\n    alpha: float = 0.70,\n    normalize: bool = True,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise address similarity matrix adhering to scikit-learn pairwise kernel conventions.\n\n    Args:\n        X: Sequence of address strings of length N.\n        Y: Optional sequence of address strings of length M. If None, computes pairwise similarity\n           of X against itself (symmetric N x N).\n        metric: Similarity metric to use: 'hybrid' (blended token + Levenshtein),\n                'token' (token set ratio), 'levenshtein' (raw Levenshtein edit ratio),\n                or 'street' (street name similarity with digit lock).\n        alpha: Weight for token similarity when metric='hybrid' (default: 0.70).\n        normalize: If True (default), normalizes scores to range [0.0, 1.0].\n                   If False, returns raw percentage scores [0.0, 100.0].\n\n    Returns:\n        2D numpy array of shape (len(X), len(Y or X)) with float32 similarity values.\n    \"\"\"\n    if len(X) == 0:\n        y_len = len(X) if Y is None else len(Y)\n        return np.zeros((0, y_len), dtype=np.float32)\n\n    norm_x = [normalize_ascii(x).strip(\" ,-\") for x in X]\n    norm_y = norm_x if Y is None else [normalize_ascii(y).strip(\" ,-\") for y in Y]\n\n    if len(norm_y) == 0:\n        return np.zeros((len(norm_x), 0), dtype=np.float32)\n\n    if metric == \"token\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"levenshtein\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"hybrid\":\n        raw_token = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n        raw_lev = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n        raw = (alpha * raw_token + (1.0 - alpha) * raw_lev).astype(np.float32)\n    elif metric == \"street\":\n        x_list = list(X)\n        y_list = x_list if Y is None else list(Y)\n        raw = np.empty((len(x_list), len(y_list)), dtype=np.float32)\n        if Y is None:\n            n = len(x_list)\n            for i in range(n):\n                raw[i, i] = evaluate_street_similarity(x_list[i], x_list[i])\n                for j in range(i + 1, n):\n                    s = evaluate_street_similarity(x_list[i], x_list[j])\n                    raw[i, j] = s\n                    raw[j, i] = s\n        else:\n            for i, x in enumerate(x_list):\n                for j, y in enumerate(y_list):\n                    raw[i, j] = evaluate_street_similarity(x, y)\n        return raw if normalize else (raw * 100.0).astype(np.float32)\n    else:\n        raise ValueError(\n            f\"Unknown metric {metric!r}. Expected 'hybrid', 'token', 'levenshtein', or 'street'.\"\n        )\n\n    return (raw / 100.0).astype(np.float32) if normalize else raw\n\n\ndef compute_similarity_matrix(\n    queries: Sequence[str],\n    choices: Sequence[str],\n    *,\n    normalize: bool = False,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise similarity matrix using vectorized batch execution.\n\n    Delegates to :func:`pairwise_address_similarity` with metric='token'.\n    \"\"\"\n    return pairwise_address_similarity(queries, choices, metric=\"token\", normalize=normalize)\n\n\n@overload\ndef address_similarity_score(\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"from ..cleaners.query_cleaner import (\n    canonicalize_lexical_token,\n    title_norm_for,\n)\nfrom ..cleaners.text_utils import strip_street_or_alley_prefix, word_tokens\nfrom ..cleaners.unicode import normalize_ascii\nfrom ..constants import STREET_PREFIX_RE\nfrom ..grammar.categories import GENERIC_POI_QUALIFIERS, PUDO_GATE_QUALIFIERS\nfrom ..grammar.matching import (\n    ALPHA_SUFFIX_RE,\n    DIGIT_ALPHANUM_TOKEN_RE,\n    DUONG_SO_PREFIX_RE,\n    LEADING_ZERO_RE,\n)\nfrom ..grammar.patterns import build_substring_boundary_pattern\nfrom ..grammar.thoroughfare import DIGIT_MATCH_RE, NON_DIGIT_RE, STREET_QUALIFIERS\nfrom ..grammar.vocabulary import GENERIC_MALL_TOKENS\nfrom ..parsers.alley import normalize_house_number_canonical\n\n_NON_DILUTING_QUALIFIERS: Final[frozenset[str]] = (\n    STREET_QUALIFIERS\n    | PUDO_GATE_QUALIFIERS\n    | GENERIC_POI_QUALIFIERS\n    | GENERIC_MALL_TOKENS\n    | frozenset({\"cafe\", \"coffee\", \"quan\", \"tiem\"})\n)\n    \"\"\"Check if shorter string is a word-boundary delimited substring of longer.\"\"\"\n    tokens = shorter.split()\n    if len(tokens) >= 2 or len(shorter) >= 8:\n        if build_substring_boundary_pattern(shorter).search(longer):\n            return True\n    return False\n\n\ndef evaluate_street_similarity(\n    name_a: str | None,\n    name_b: str | None,\n    threshold: float = 0.82,\n) -> float:\n    \"\"\"Compute street name similarity incorporating prefix stripping, digit lock, and word boundaries.\n\n    Parameters\n    ----------\n    name_a : str or None\n        First street name (e.g., declared street).\n    name_b : str or None\n        Second street name (e.g., candidate OSM road name).\n    threshold : float, default=0.82\n        Decision threshold for near-miss floor penalty.\n\n    Returns\n    -------\n\n\ndef pairwise_address_similarity(\n    X: Sequence[str],\n    Y: Sequence[str] | None = None,\n    *,\n    metric: Literal[\"hybrid\", \"token\", \"levenshtein\", \"street\"] | str = \"hybrid\",\n    alpha: float = 0.70,\n    normalize: bool = True,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise address similarity matrix adhering to scikit-learn pairwise kernel conventions.\n\n    Args:\n        X: Sequence of address strings of length N.\n        Y: Optional sequence of address strings of length M. If None, computes pairwise similarity\n           of X against itself (symmetric N x N).\n        metric: Similarity metric to use: 'hybrid' (blended token + Levenshtein),\n                'token' (token set ratio), 'levenshtein' (raw Levenshtein edit ratio),\n                or 'street' (street name similarity with digit lock).\n        alpha: Weight for token similarity when metric='hybrid' (default: 0.70).\n        normalize: If True (default), normalizes scores to range [0.0, 1.0].\n                   If False, returns raw percentage scores [0.0, 100.0].\n\n    Returns:\n        2D numpy array of shape (len(X), len(Y or X)) with float32 similarity values.\n    \"\"\"\n    if len(X) == 0:\n        y_len = len(X) if Y is None else len(Y)\n        return np.zeros((0, y_len), dtype=np.float32)\n\n    norm_x = [normalize_ascii(x).strip(\" ,-\") for x in X]\n    norm_y = norm_x if Y is None else [normalize_ascii(y).strip(\" ,-\") for y in Y]\n\n    if len(norm_y) == 0:\n        return np.zeros((len(norm_x), 0), dtype=np.float32)\n\n    if metric == \"token\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"levenshtein\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"hybrid\":\n        raw_token = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n        raw_lev = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n        raw = (alpha * raw_token + (1.0 - alpha) * raw_lev).astype(np.float32)\n    elif metric == \"street\":\n        x_list = list(X)\n        y_list = x_list if Y is None else list(Y)\n        raw = np.empty((len(x_list), len(y_list)), dtype=np.float32)\n        if Y is None:\n            n = len(x_list)\n            for i in range(n):\n                raw[i, i] = evaluate_street_similarity(x_list[i], x_list[i])\n                for j in range(i + 1, n):\n                    s = evaluate_street_similarity(x_list[i], x_list[j])\n                    raw[i, j] = s\n                    raw[j, i] = s\n        else:\n            for i, x in enumerate(x_list):\n                for j, y in enumerate(y_list):\n                    raw[i, j] = evaluate_street_similarity(x, y)\n        return raw if normalize else (raw * 100.0).astype(np.float32)\n    else:\n        raise ValueError(\n            f\"Unknown metric {metric!r}. Expected 'hybrid', 'token', 'levenshtein', or 'street'.\"\n        )\n\n    return (raw / 100.0).astype(np.float32) if normalize else raw\n\n\ndef compute_similarity_matrix(\n    queries: Sequence[str],\n    choices: Sequence[str],\n    *,\n    normalize: bool = False,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise similarity matrix using vectorized batch execution.\n\n    Delegates to :func:`pairwise_address_similarity` with metric='token'.\n    \"\"\"\n    return pairwise_address_similarity(queries, choices, metric=\"token\", normalize=normalize)\n\n\n@overload\ndef address_similarity_score(\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_058518ef1a8f22c5016ae844ed6a708191adfc3c9cc4cae27d"}},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '35,60p;150,175p;265,360p' /tmp/prosev-new/vihap/matching/similarity.py\",\"timeout\":120000}"},"time":{"sta