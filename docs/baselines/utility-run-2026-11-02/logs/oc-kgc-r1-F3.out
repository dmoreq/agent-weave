ns an entity of specified type with early exit.\"\"\"\n   252\t        if not text:\n   253\t            return False\n   254\t        norm = unicodedata.normalize(\"NFKC\", text).lower().translate(_ascii_diacritic_trans())\n   255\t        if not norm:\n   256\t            return False\n   257\t        auto, n_len = cls._get_automaton(), len(norm)\n   258\t        for end_idx, payload in auto.iter(norm):\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_0eeeb584ed9c4050016ae84551e2a08191bef6492e4a038f70"}},"providerResult":{"executed":false},"rawInput":"{\"command\": \"nl -ba vihap/grammar/entity.py | sed -n '45,58p;90,103p;246,258p'\", \"timeout\": 120000}"},"time":{"start":1793606994111,"end":1793606994211}}}}
{"type":"tool_use","timestamp":1793606994231,"sessionID":"ses_util_oc_kgc_r1_F3","part":{"partID":"prt_19b4ec8b70017iRG6wBAdfevpi","sessionID":"ses_util_oc_kgc_r1_F3","messageID":"msg_19b4eb1eb0015ukWUFC1nGxqLY","type":"tool","id":"call_e9f77c2a07384e45962f951608d3b0aa","tool":"shell","state":{"status":"completed","input":{"command":"nl -ba vihap/cleaners/unicode.py | sed -n '1,75p'","timeout":120000},"output":"     1\t\"\"\"Zero-dependency Unicode normalization and ASCII transliteration primitives.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport functools\n     6\timport unicodedata\n     7\tfrom typing import cast\n     8\t\n     9\t__all__ = [\n    10\t    \"normalize_ascii\",\n    11\t    \"normalize_unicode_nfkc\",\n    12\t]\n    13\t\n    14\t\n    15\tdef normalize_unicode_nfkc(text: str) -> str:\n    16\t    \"\"\"Normalize unicode to NFKC (converts mathematical/stylized Unicode to standard alphanumerics).\"\"\"\n    17\t    if not text:\n    18\t        return \"\"\n    19\t    return unicodedata.normalize(\"NFKC\", text)\n    20\t\n    21\t\n    22\t@functools.lru_cache(maxsize=1)\n    23\tdef _ascii_diacritic_trans() -> dict[int, int | str | None]:\n    24\t    \"\"\"Build a C-accelerated translate table mirroring NFD + Mn-stripping + đ→d.\"\"\"\n    25\t    mapping: dict[str, str | None] = {\"đ\": \"d\", \"Đ\": \"d\"}\n    26\t    # Scan relevant Latin, Vietnamese, Combining Diacritics, and Fullwidth blocks\n    27\t    ranges = (\n    28\t        range(0x0000, 0x2500),\n    29\t        range(0x1DC0, 0x2000),\n    30\t        range(0x20D0, 0x2100),\n    31\t        range(0xFE20, 0xFE30),\n    32\t        range(0xFF00, 0xFFF0),\n    33\t    )\n    34\t    for r in ranges:\n    35\t        for char in map(chr, r):\n    36\t            if unicodedata.category(char) == \"Mn\":\n    37\t                mapping[char] = None\n    38\t                continue\n    39\t            decomposed = unicodedata.normalize(\"NFD\", char)\n    40\t            base = \"\".join(c for c in decomposed if unicodedata.category(c) != \"Mn\")\n    41\t            if len(base) == 1 and base != char:\n    42\t                mapping[char] = base\n    43\t    return cast(dict[int, int | str | None], str.maketrans(mapping))\n    44\t\n    45\t\n    46\t@functools.lru_cache(maxsize=32768)\n    47\tdef normalize_ascii(text: str | None) -> str:\n    48\t    \"\"\"Normalize string to lowercase, strip diacritics and convert đ/Đ to d.\"\"\"\n    49\t    if not text:\n    50\t        return \"\"\n    51\t    raw = str(text)\n    52\t    if raw.isascii():\n    53\t        return raw.lower().strip()\n    54\t    normalized = unicodedata.normalize(\"NFKC\", raw.lower().strip())\n    55\t    return normalized.translate(_ascii_diacritic_trans())\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"     1\t\"\"\"Zero-dependency Unicode normalization and ASCII transliteration primitives.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport functools\n     6\timport unicodedata\n     7\tfrom typing import cast\n     8\t\n     9\t__all__ = [\n    10\t    \"normalize_ascii\",\n    11\t    \"normalize_unicode_nfkc\",\n    12\t]\n    13\t\n    14\t\n    15\tdef normalize_unicode_nfkc(text: str) -> str:\n    16\t    \"\"\"Normalize unicode to NFKC (converts mathematical/stylized Unicode to standard alphanumerics).\"\"\"\n    17\t    if not text:\n    18\t        return \"\"\n    19\t    return unicodedata.normalize(\"NFKC\", text)\n    20\t\n    21\t\n    22\t@functools.lru_cache(maxsize=1)\n    23\tdef _ascii_diacritic_trans() -> dict[int, int | str | None]:\n    24\t    \"\"\"Build a C-accelerated translate table mirroring NFD + Mn-stripping + đ→d.\"\"\"\n    25\t    mapping: dict[str, str | None] = {\"đ\": \"d\", \"Đ\": \"d\"}\n    26\t    # Scan relevant Latin, Vietnamese, Combining Diacritics, and Fullwidth blocks\n    27\t    ranges = (\n    28\t        range(0x0000, 0x2500),\n    29\t        range(0x1DC0, 0x2000),\n    30\t        range(0x20D0, 0x2100),\n    31\t        range(0xFE20, 0xFE30),\n    32\t        range(0xFF00, 0xFFF0),\n    33\t    )\n    34\t    for r in ranges:\n    35\t        for char in map(chr, r):\n    36\t            if unicodedata.category(char) == \"Mn\":\n    37\t                mapping[char] = None\n    38\t                continue\n    39\t            decomposed = unicodedata.normalize(\"NFD\", char)\n    40\t            base = \"\".join(c for c in decomposed if unicodedata.category(c) != \"Mn\")\n    41\t            if len(base) == 1 and base != char:\n    42\t                mapping[char] = base\n    43\t    return cast(dict[int, int | str | None], str.maketrans(mapping))\n    44\t\n    45\t\n    46\t@functools.lru_cache(maxsize=32768)\n    47\tdef normalize_ascii(text: str | None) -> str:\n    48\t    \"\"\"Normalize string to lowercase, strip diacritics and convert đ/Đ to d.\"\"\"\n    49\t    if not text:\n    50\t        return \"\"\n    51\t    raw = str(text)\n    52\t    if raw.isascii():\n    53\t        return raw.lower().strip()\n    54\t    normalized = unicodedata.normalize(\"NFKC\", raw.lower().strip())\n    55\t    return normalized.translate(_ascii_diacritic_trans())\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_0eeeb584ed9c4050016ae84550c2048191ba8a535a50d6b9e8"}},"providerResult":{"executed":false},"rawInput":"{\"command\": \"nl -ba vihap/cleaners/unicode.py | sed -n '1,75p'\", \"timeout\": 120000}"},"time":{"start":1793606994103,"end":1793606994231}}}}
