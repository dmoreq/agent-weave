rcase ASCII.\"\"\"\n42:     if not text:\n43:         return \"\"\n44:     return normalize_ascii(strip_admin_prefix(text))\n45: \n46: \n47: @functools.lru_cache(maxsize=8192)\n48: def normalize_admin_name(name: str | None) -> str:\n49:     \"\"\"Normalize administrative names for indexing, merging, and entity matching.\n50: \n51:     - Returns \"\" if name is None or empty.\n52:     - Normalize to ASCII lowercase and strip diacritics via normalize_ascii().\n53:     - Map common regional aliases:\n54:       - {\"tp.hcm\", \"tp hcm\", \"tphcm\", \"hcm\", \"sai gon\"} -> \"ho chi minh\"\n55:       - {\"tp.hn\", \"tp hn\", \"tphn\", \"hn\"} -> \"ha noi\"\n56:     - Strip official administrative prefixes using word boundaries:\n57:       tỉnh, thành phố, tp., tp, t., quận, q., q, huyện, h., h, thị xã, tx., tx,\n58:       phường, p., p, xã, x., x, thị trấn, tt., tt.\n59:       Be careful with single letters (q, h, p, t, x) so that words like \"quang ninh\",\n60:       \"ha giang\", \"phan thiet\" are not altered.\n61:     - Whitespace collapsing via collapse_whitespace() or regex.\n62: \n63:     Parameters\n64:     ----------\n65:     name : str | None\n66:         Administrative unit name (province, district, ward).\n67: \n68:     Returns\n69:     -------\n70:     str\n71:         Canonical normalized administrative name in ASCII lowercase.\n72: \n73:     Examples\n74:     --------\n75:     >>> normalize_admin_name(\"Thành phố Hồ Chí Minh\")\n76:     'ho chi minh'\n77:     >>> normalize_admin_name(\"TP.HCM\")\n78:     'ho chi minh'\n79:     >>> normalize_admin_name(\"Quận Ninh Kiều\")\n80:     'ninh kieu'\n81:     >>> normalize_admin_name(\"Thị trấn Trâu Quỳ\")\n82:     'trau quy'\n83:     >>> normalize_admin_name(\"Xã An Khánh\")\n84:     'an khanh'\n85:     \"\"\"\n86:     if not name:\n87:         return \"\"\n88:     cleaned = collapse_whitespace(name)\n89:     if not cleaned:\n90:         return \"\"\n91: \n92:     norm = normalize_ascii(cleaned)\n93:     norm = _D