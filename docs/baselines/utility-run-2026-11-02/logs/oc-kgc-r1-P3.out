 NULL AND lon IS NOT NULL\")\n1411:     for w_code, lat, lon in cursor.fetchall():\n1412:         if w_code:\n1413:             ward_centroids[str(w_code).strip()] = (float(lat), float(lon))\n1414: \n1415:     # Named centroids\n1416:     d_m: dict[tuple[str, str], tuple[float, float]] = {}\n1417:     w_m: dict[tuple[str, str, str], tuple[float, float]] = {}\n1418:     w2_m: dict[tuple[str, str], tuple[float, float]] = {}\n1419:     cursor.execute(\n1420:         \"SELECT p.name, d.name, d.lat, d.lon FROM districts d JOIN provinces p ON d.province_code = p.code WHERE d.lat IS NOT NULL\"\n1421:     )\n1422:     for p_name, d_name, lat, lon in cursor.fetchall():\n1423:         d_m[(normalize_admin_name(p_name), normalize_admin_name(d_name))] = (float(lat), float(lon))\n1424:     cursor.execute(\n1425:         \"SELECT p.name, d.name, w.name, w.lat, w.lon FROM wards w JOIN districts d ON w.district_code = d.code JOIN provinces p ON w.province_code = p.code WHERE w.lat IS NOT NULL\"\n1426:     )\n1427:     for p_name, d_name, w_name, lat, lon in cursor.fetchall():\n1428:         w_m[\n1429:             (\n1430:                 normalize_admin_name(p_name),\n1431:                 normalize_admin_name(d_name),\n1432:                 normalize_admin_name(w_name),\n1433:             )\n1434:         ] = (float(lat), float(lon))\n1435:     cursor.execute(\n1436:         \"SELECT p.name, w.name, w.lat, w.lon FROM wards_2tier w JOIN provinces_2tier p ON w.province_code = p.code WHERE w.lat IS NOT NULL\"\n1437:     )\n1438:     for p_name, w_name, lat, lon in cursor.fetchall():\n1439:         w2_m[(normalize_admin_name(p_name), normalize_admin_name(w_name))] = (\n1440:             float(lat),\n1441:             float(lon),\n1442:         )\n1443:     named_centroids = (d_m, w_m, w2_m)\n1444: \n1445:     # Reforms\n1446:     w_clusters = _build_ward_merger_clusters_from_sqlite(conn)\n1447:     prov_reforms: set[tuple[str, str]] = set()\n1448:     cursor.execute(\n1449:         \"\"\"\n1450:         SELECT ro.old_province, p2.name\n1451:         FROM reform_origins ro\n1452:         JOIN wards_2tier w2 ON ro.new_ward_code = w2.code\n1453:         JOIN provinces_2tier p2 ON w2.province_code = p2.code\n1454:         WHERE ro.old_province IS NOT NULL AND p2.name IS NOT NULL\n1455:         \"\"\"\n1456:     )\n1457:     for old_p, new_p in cursor.fetchall():\n1458:         norm_old = normalize_admin_name(old_p)\n1459:         norm_new = normalize_admin_name(new_p)\n1460:         if norm_old and norm_new:\n1461:             prov_reforms.add((norm_old, norm_new))\n1462: \n1463:     parent_codes: dict[str, tuple[str | None, str | None]] = {}\n1464:     cursor.execute(\"SELECT code, province_code, district_code FROM wards WHERE code IS NOT NULL\")\n1465:     for w_code, p_code, d_code in cursor.fetchall():\n1466:         if w_code:\n1467:             w_clean = str(w_code).strip()\n1468:             p_clean = str(p_code).strip() if p_code else None\n1469:             d_clean = str(d_code).strip() if d_code else None\n1470:             val = (p_clean, d_clean)\n1471:             parent_codes[w_clean] = val\n1472:             parent_codes[w_clean.zfill(5)] = (\n1473:                 p_clean.zfill(2) if p_clean else None,\n1474:                 d_clean.zfill(3) if d_clean else None,\n1475:             )\n1476:             unpad = w_clean.lstrip(\"0\")\n1477:             if unpad:\n1478:                 parent_codes[unpad] = (\n1479:                     p_clean.lstrip(\"0\") if p_clean else None,\n1480:                     d_clean.lstrip(\"0\") if d_clean else None,\n1481:                 )\n1482: \n1483:     cursor.execute(\"SELECT code, province_code FROM wards_2tier WHERE code IS NOT NULL\")\n1484:     for w_code, p_code in cursor.fetchall():\n1485:         if w_code:\n1486:             w_clean = str(w_code).strip()\n1487:             p_clean = str(p_code).strip() if p_code else None\n1488:             if w_clean not in parent_codes:\n1489:          