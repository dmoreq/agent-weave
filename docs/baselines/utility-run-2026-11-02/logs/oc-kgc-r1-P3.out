{"type":"tool_use","timestamp":1793581885204,"sessionID":"ses_util_oc_kgc_r1_P3","part":{"partID":"prt_199cfa680001yI0ojaxQNzAo7H","sessionID":"ses_util_oc_kgc_r1_P3","messageID":"msg_199cf7e53001iYdoNI86dWrB41","type":"tool","id":"call_057d0f1e187a4926bd0203a32596d73a","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/utility-corpus-2026-11-02/vihap/vihap/knowledge/reform_utils.py","offset":1,"limit":100},"output":"Read file /private/tmp/utility-corpus-2026-11-02/vihap/vihap/knowledge/reform_utils.py, lines 1-100\n1: \"\"\"Administrative reform helpers backed by the runtime knowledge base.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import sqlite3\n6: from collections import defaultdict\n7: \n8: from .base import AdminNamedCentroids\n9: from .registry import get_knowledge_base\n10: \n11: \n12: def _ward_code_variants(code: str) -> frozenset[str]:\n13:     c = code.strip()\n14:     if not c:\n15:         return frozenset()\n16:     variants = {c}\n17:     if c.isdigit():\n18:         int_c = int(c)\n19:         variants.add(f\"{int_c:05d}\")\n20:         variants.add(str(int_c))\n21:     return frozenset(variants)\n22: \n23: \n24: def get_shared_ward_merger_clusters(\n25:     conn: sqlite3.Connection | None = None,\n26: ) -> dict[str, frozenset[str]]:\n27:     \"\"\"Return ward merger clusters from KB, or build from a test SQLite connection.\"\"\"\n28:     if conn is not None:\n29:         return _build_ward_merger_clusters_from_sqlite(conn)\n30:     kb = get_knowledge_base()\n31:     if kb is None:\n32:         return {}\n33:     return kb.get_ward_merger_clusters()\n34: \n35: \n36: def _build_ward_merger_clusters_from_sqlite(\n37:     conn: sqlite3.Connection,\n38: ) -> dict[str, frozenset[str]]:\n39:     adjacency: dict[str, set[str]] = defaultdict(set)\n40: \n41:     def add_edge(code_a: str, code_b: str) -> None:\n42:         c_a = code_a.strip()\n43:         c_b = code_b.strip()\n44:         if not c_a or not c_b or c_a == c_b:\n45:             return\n46:         for variant_a in _ward_code_variants(c_a):\n47:             for variant_b in _ward_code_variants(c_b):\n48:                 adjacency[variant_a].add(variant_b)\n49:                 adjacency[variant_b].add(variant_a)\n50: \n51:     cursor = conn.cursor()\n52:     try:\n53:         cursor.execute(\n54:             \"\"\"\n55:             SELECT code, merged_into_code\n56:             FROM wards\n57:             WHERE merged_into_code IS NOT NULL AND merged_into_code != ''\n58:             \"\"\"\n59:         )\n60:         for code, merged_into_code in cursor.fetchall():\n61:             add_edge(str(code), str(merged_into_code))\n62: \n63:         cursor.execute(\n64:             \"\"\"\n65:             SELECT new_ward_code, old_ward_code\n66:             FROM reform_origins\n67:             WHERE old_ward_code IS NOT NULL AND old_ward_code != '' AND is_primary = 1\n68:             \"\"\"\n69:         )\n70:         for new_ward_code, old_ward_code in cursor.fetchall():\n71:             add_edge(str(new_ward_code), str(old_ward_code))\n72:     except Exception:\n73:         return {}\n74: \n75:     for code in list(adjacency):\n76:         for variant_a in _ward_code_variants(code):\n77:             for variant_b in _ward_code_variants(code):\n78:                 if variant_a != variant_b:\n79:                     adjacency[variant_a].add(variant_b)\n80: \n81:     clusters: dict[str, frozenset[str]] = {}\n82:     visited: set[str] = set()\n83: \n84:     for start in adjacency:\n85:         if start in visited:\n86:             continue\n87:         component: set[str] = set()\n88:         queue = [start]\n89:         while queue:\n90:             node = queue.pop()\n91:             if node in component:\n92:                 continue\n93:             component.add(node)\n94:             for neighbor in adjacency[node]:\n95:                 if neighbor not in component:\n96:                     queue.append(neighbor)\n97:   