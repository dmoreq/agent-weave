{"type":"tool_use","timestamp":1793606950804,"sessionID":"ses_util_oc_kgc_r2_F1","part":{"partID":"prt_19b4e1f4e001fgdiR6T5FV8HHi","sessionID":"ses_util_oc_kgc_r2_F1","messageID":"msg_19b4e0b650019ETBQWKvu2ZhsL","type":"tool","id":"call_3d72079131734b6493fa8b18d74347b2","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '267,359p' vihap/matching/similarity.py","workdir":"/tmp/prosev-new"},"output":"def pairwise_address_similarity(\n    X: Sequence[str],\n    Y: Sequence[str] | None = None,\n    *,\n    metric: Literal[\"hybrid\", \"token\", \"levenshtein\", \"street\"] | str = \"hybrid\",\n    alpha: float = 0.70,\n    normalize: bool = True,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise address similarity matrix adhering to scikit-learn pairwise kernel conventions.\n\n    Args:\n        X: Sequence of address strings of length N.\n        Y: Optional sequence of address strings of length M. If None, computes pairwise similarity\n           of X against itself (symmetric N x N).\n        metric: Similarity metric to use: 'hybrid' (blended token + Levenshtein),\n                'token' (token set ratio), 'levenshtein' (raw Levenshtein edit ratio),\n                or 'street' (street name similarity with digit lock).\n        alpha: Weight for token similarity when metric='hybrid' (default: 0.70).\n        normalize: If True (default), normalizes scores to range [0.0, 1.0].\n                   If False, returns raw percentage scores [0.0, 100.0].\n\n    Returns:\n        2D numpy array of shape (len(X), len(Y or X)) with float32 similarity values.\n    \"\"\"\n    if len(X) == 0:\n        y_len = len(X) if Y is None else len(Y)\n        return np.zeros((0, y_len), dtype=np.float32)\n\n    norm_x = [normalize_ascii(x).strip(\" ,-\") for x in X]\n    norm_y = norm_x if Y is None else [normalize_ascii(y).strip(\" ,-\") for y in Y]\n\n    if len(norm_y) == 0:\n        return np.zeros((len(norm_x), 0), dtype=np.float32)\n\n    if metric == \"token\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"levenshtein\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"hybrid\":\n        raw_token = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n        raw_lev = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n        raw = (alpha * raw_token + (1.0 - alpha) * raw_lev).astype(np.float32)\n    elif metric == \"street\":\n        x_list = list(X)\n        y_list = x_list if Y is None else list(Y)\n        raw = np.empty((len(x_list), len(y_list)), dtype=np.float32)\n        if Y is None:\n            n = len(x_list)\n            for i in range(n):\n                raw[i, i] = evaluate_street_similarity(x_list[i], x_list[i])\n                for j in range(i + 1, n):\n                    s = evaluate_street_similarity(x_list[i], x_list[j])\n                    raw[i, j] = s\n                    raw[j, i] = s\n        else:\n            for i, x in enumerate(x_list):\n                for j, y in enumerate(y_list):\n                    raw[i, j] = evaluate_street_similarity(x, y)\n        return raw if normalize else (raw * 100.0).astype(np.float32)\n    else:\n        raise ValueError(\n            f\"Unknown metric {metric!r}. Expected 'hybrid', 'token', 'levenshtein', or 'street'.\"\n        )\n\n    return (raw / 100.0).astype(np.float32) if normalize else raw\n\n\ndef compute_similarity_matrix(\n    queries: Sequence[str],\n    choices: Sequence[str],\n    *,\n    normalize: bool = False,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise similarity matrix using vectorized batch execution.\n\n    Delegates to :func:`pairwise_address_similarity` with metric='token'.\n    \"\"\"\n    return pairwise_address_similarity(queries, choices, metric=\"token\", normalize=normalize)\n\n\n@overload\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"def pairwise_address_similarity(\n    X: Sequence[str],\n    Y: Sequence[str] | None = None,\n    *,\n    metric: Literal[\"hybrid\", \"token\", \"levenshtein\", \"street\"] | str = \"hybrid\",\n    alpha: float = 0.70,\n    normalize: bool = True,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise address similarity matrix adhering to scikit-learn pairwise kernel conventions.\n\n    Args:\n        X: Sequence of address strings of length N.\n        Y: Optional sequence of address strings of length M. If None, computes pairwise similarity\n           of X against itself (symmetric N x N).\n        metric: Similarity metric to use: 'hybrid' (blended token + Levenshtein),\n                'token' (token set ratio), 'levenshtein' (raw Levenshtein edit ratio),\n                or 'street' (street name similarity with digit lock).\n        alpha: Weight for token similarity when metric='hybrid' (default: 0.70).\n        normalize: If True (default), normalizes scores to range [0.0, 1.0].\n                   If False, returns raw percentage scores [0.0, 100.0].\n\n    Returns:\n        2D numpy array of shape (len(X), len(Y or X)) with float32 similarity values.\n    \"\"\"\n    if len(X) == 0:\n        y_len = len(X) if Y is None else len(Y)\n        return np.zeros((0, y_len), dtype=np.float32)\n\n    norm_x = [normalize_ascii(x).strip(\" ,-\") for x in X]\n    norm_y = norm_x if Y is None else [normalize_ascii(y).strip(\" ,-\") for y in Y]\n\n    if len(norm_y) == 0:\n        return np.zeros((len(norm_x), 0), dtype=np.float32)\n\n    if metric == \"token\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"levenshtein\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"hybrid\":\n        raw_token = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n        raw_lev = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n        raw = (alpha * raw_token + (1.0 - alpha) * raw_lev).astype(np.float32)\n    elif metric == \"street\":\n        x_list = list(X)\n        y_list = x_list if Y is None else list(Y)\n        raw = np.empty((len(x_list), len(y_list)), dtype=np.float32)\n        if Y is None:\n            n = len(x_list)\n            for i in range(n):\n                raw[i, i] = evaluate_street_similarity(x_list[i], x_list[i])\n                for j in range(i + 1, n):\n                    s = evaluate_street_similarity(x_list[i], x_list[j])\n                    raw[i, j] = s\n                    raw[j, i] = s\n        else:\n            for i, x in enumerate(x_list):\n                for j, y in enumerate(y_list):\n                    raw[i, j] = evaluate_street_similarity(x, y)\n        return raw if normalize else (raw * 100.0).astype(np.float32)\n    else:\n        raise ValueError(\n            f\"Unknown metric {metric!r}. Expected 'hybrid', 'token', 'levenshtein', or 'street'.\"\n        )\n\n    return (raw / 100.0).astype(np.float32) if normalize else raw\n\n\ndef compute_similarity_matrix(\n    queries: Sequence[str],\n    choices: Sequence[str],\n    *,\n    normalize: bool = False,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise similarity matrix using vectorized batch execution.\n\n    Delegates to :func:`pairwise_address_similarity` with metric='token'.\n    \"\"\"\n    return pairwise_address_similarity(queries, choices, metric=\"token\", normalize=normalize)\n\n\n@overload\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_0acbb55aeaa3d1cf016ae8452572108191b30390d869492125"}},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '267,359p' vihap/matching/similarity.py\",\"workdir\":\"/tmp/prosev-new\"}"},"time":{"start":1793606950735,"end":1793606950804}}}}
