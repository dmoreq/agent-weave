{"type":"tool_use","timestamp":1793606785972,"sessionID":"ses_util_oc_kgc_r1_F2","part":{"partID":"prt_19b4b95d300139jhH2jDXjwc3w","sessionID":"ses_util_oc_kgc_r1_F2","messageID":"msg_19b4b76c4001j8gIsWQR8k1gz4","type":"tool","id":"call_5ad590102cd44bbaafb57b2b06766dba","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '20,57p' tests/test_abbreviation_engine.py","timeout":120000},"output":"        (\"pho 8/3\", \"Phố 8/3\"),\n    ],\n)\ndef test_resolve_street_global_aliases(\n    engine: AbbreviationEngine, alias: str, expected_canonical: str\n):\n    resolved = engine.resolve_street(alias)\n    assert resolved is not None\n    canonical, conf, category = resolved\n    assert canonical == expected_canonical\n    assert conf >= 0.90\n    assert category == AbbrCategory.UNIVERSAL_STANDARD\n\n\ndef test_generate_street_variants_alpha_number_and_initials():\n    raw = \"Đường Thanh Lộc 16\"\n    variants = AbbreviationEngine.generate_street_variants(raw, [\"760\"], \"79\")\n    keys = {normalize_key for normalize_key, _ in variants}\n    assert \"tl16\" in keys or \"tl 16\" in keys\n    assert any(abbr.category == AbbrCategory.SCOPED_NUMBERED for _, abbr in variants)\n\n    arterial = AbbreviationEngine.generate_street_variants(\"Đường Võ Văn Kiệt\", [\"760\"], \"79\")\n    assert any(key == \"vvk\" for key, _ in arterial)\n    assert any(abbr.category == AbbrCategory.SCOPED_BARE_INITIALS for _, abbr in arterial)\n\n\ndef test_resolve_street_scoped_district_and_province(engine: AbbreviationEngine):\n    engine.register_street_variants(\"Đường Thanh Lộc 16\", [\"760\"], \"79\")\n    district_hit = engine.resolve_street(\"tl16\", district_code=\"760\", province_code=\"79\")\n    assert district_hit is not None\n    assert \"Thanh Lộc\" in district_hit[0]\n\n    engine.register_street_variants(\"Đường Võ Văn Kiệt\", [\"760\"], \"79\")\n    with_keyword = engine.resolve_street(\n        \"vvk\", district_code=\"760\", province_code=\"79\", has_street_keyword=True\n    )\n    assert with_keyword is not None\n    assert with_keyword[2] == AbbrCategory.SCOPED_ARTERIAL_WITH_KEYWORD\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"        (\"pho 8/3\", \"Phố 8/3\"),\n    ],\n)\ndef test_resolve_street_global_aliases(\n    engine: AbbreviationEngine, alias: str, expected_canonical: str\n):\n    resolved = engine.resolve_street(alias)\n    assert resolved is not None\n    canonical, conf, category = resolved\n    assert canonical == expected_canonical\n    assert conf >= 0.90\n    assert category == AbbrCategory.UNIVERSAL_STANDARD\n\n\ndef test_generate_street_variants_alpha_number_and_initials():\n    raw = \"Đường Thanh Lộc 16\"\n    variants = AbbreviationEngine.generate_street_variants(raw, [\"760\"], \"79\")\n    keys = {normalize_key for normalize_key, _ in variants}\n    assert \"tl16\" in keys or \"tl 16\" in keys\n    assert any(abbr.category == AbbrCategory.SCOPED_NUMBERED for _, abbr in variants)\n\n    arterial = AbbreviationEngine.generate_street_variants(\"Đường Võ Văn Kiệt\", [\"760\"], \"79\")\n    assert any(key == \"vvk\" for key, _ in arterial)\n    assert any(abbr.category == AbbrCategory.SCOPED_BARE_INITIALS for _, abbr in arterial)\n\n\ndef test_resolve_street_scoped_district_and_province(engine: AbbreviationEngine):\n    engine.register_street_variants(\"Đường Thanh Lộc 16\", [\"760\"], \"79\")\n    district_hit = engine.resolve_street(\"tl16\", district_code=\"760\", province_code=\"79\")\n    assert district_hit is not None\n    assert \"Thanh Lộc\" in district_hit[0]\n\n    engine.register_street_variants(\"Đường Võ Văn Kiệt\", [\"760\"], \"79\")\n    with_keyword = engine.resolve_street(\n        \"vvk\", district_code=\"760\", province_code=\"79\", has_street_keyword=True\n    )\n    assert with_keyword is not None\n    assert with_keyword[2] == AbbrCategory.SCOPED_ARTERIAL_WITH_KEYWORD\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_0835af5684698aa9016ae8448027588191b6ecda2cae6f76c4"}},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '20,57p' tests/test_abbreviation_engine.py\", \"timeout\": 120000}"},"time":{"start":1793606784467,"end":1793606785972}}}}
