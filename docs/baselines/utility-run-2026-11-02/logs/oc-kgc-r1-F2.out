{"type":"tool_use","timestamp":1793606785414,"sessionID":"ses_util_oc_kgc_r1_F2","part":{"partID":"prt_19b4b951e001CuQQTSXW5bJWnB","sessionID":"ses_util_oc_kgc_r1_F2","messageID":"msg_19b4b76c4001j8gIsWQR8k1gz4","type":"tool","id":"call_e761e9399d1c4d5c89596d82b24a3128","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '45,66p;340,368p;408,442p' vihap/cleaners/abbreviation_engine.py","timeout":120000},"output":")\nfrom ..grammar.thoroughfare import STREET_PREFIX_RE\nfrom .text_utils import build_term_automaton, normalize_ascii, replace_terms_automaton\n\n\ndef expand_mobile_admin_shorthand(text: str | None) -> str:\n    \"\"\"Expand mobile administrative shorthand tokens (e.g., 'q7' -> 'quận 7', 'p2' -> 'phường 2').\"\"\"\n    if not text:\n        return \"\"\n    expanded = RE_MOBILE_DISTRICT.sub(r\"quận \\1\", text)\n    return RE_MOBILE_WARD.sub(r\"phường \\1\", expanded)\n\n\ndef _strip_street_keyword_prefix(text: str) -> str:\n    \"\"\"Strip canonical street prefix using shared STREET_PREFIX_RE.\"\"\"\n    return STREET_PREFIX_RE.sub(\"\", text).strip()\n\n\nfrom ..grammar.vocabulary import (\n    COMMERCIAL_AND_CIVIC_ACRONYMS as COMMERCIAL_AND_CIVIC_ACRONYMS,\n)\n\n    ) -> None:\n        \"\"\"Register street acronym variants into the inverted index.\"\"\"\n        variants = self.generate_street_variants(raw_name, district_codes, province_code)\n        for key, abbr in variants:\n            norm_key = normalize_ascii(key)\n            self.scoped_street_abbrs.setdefault(norm_key, []).append(abbr)\n\n    def _resolve_global_alias(\n        self,\n        norm_token: str,\n        stripped_token: str,\n    ) -> tuple[str, float, AbbrCategory] | None:\n        if norm_token in self.global_aliases:\n            canonical, conf = self.global_aliases[norm_token]\n            return canonical, conf, AbbrCategory.UNIVERSAL_STANDARD\n        if stripped_token in self.global_aliases:\n            canonical, conf = self.global_aliases[stripped_token]\n            return canonical, conf, AbbrCategory.UNIVERSAL_STANDARD\n        return None\n\n    @staticmethod\n    def _scoped_candidates_for_token(\n        scoped_index: dict[str, list[ScopedStreetAbbr]],\n        norm_token: str,\n        stripped_token: str,\n    ) -> list[ScopedStreetAbbr] | None:\n        return scoped_index.get(stripped_token) or scoped_index.get(norm_token)\n\n    @staticmethod\n            matched.canonical_name,\n            AbbrCategory.UNSCOPED_FALLBACK.default_confidence,\n            AbbrCategory.UNSCOPED_FALLBACK,\n        )\n\n    def _resolve_scoped_street(\n        self,\n        candidates: list[ScopedStreetAbbr],\n        *,\n        norm_token: str,\n        district_code: str | None,\n        province_code: str | None,\n        has_street_keyword: bool,\n    ) -> tuple[str, float, AbbrCategory] | None:\n        if district_code:\n            district_hit = self._resolve_district_scoped_match(\n                candidates,\n                district_code=district_code,\n                has_street_keyword=has_street_keyword,\n            )\n            if district_hit is not None:\n                return district_hit\n        if province_code:\n            province_hit = self._resolve_province_scoped_match(candidates, province_code)\n            if province_hit is not None:\n                return province_hit\n        return self._resolve_unique_unscoped_match(candidates, norm_token)\n\n    def resolve_street(\n        self,\n        token: str,\n        district_code: str | None = None,\n        province_code: str | None = None,\n        has_street_keyword: bool = False,\n    ) -> tuple[str, float, AbbrCategory] | None:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":")\nfrom ..grammar.thoroughfare import STREET_PREFIX_RE\nfrom .text_utils import build_term_automaton, normalize_ascii, replace_terms_automaton\n\n\ndef expand_mobile_admin_shorthand(text: str | None) -> str:\n    \"\"\"Expand mobile administrative shorthand tokens (e.g., 'q7' -> 'quận 7', 'p2' -> 'phường 2').\"\"\"\n    if not text:\n        return \"\"\n    expanded = RE_MOBILE_DISTRICT.sub(r\"quận \\1\", text)\n    return RE_MOBILE_WARD.sub(r\"phường \\1\", expanded)\n\n\ndef _strip_street_keyword_prefix(text: str) -> str:\n    \"\"\"Strip canonical street prefix using shared STREET_PREFIX_RE.\"\"\"\n    return STREET_PREFIX_RE.sub(\"\", text).strip()\n\n\nfrom ..grammar.vocabulary import (\n    COMMERCIAL_AND_CIVIC_ACRONYMS as COMMERCIAL_AND_CIVIC_ACRONYMS,\n)\n\n    ) -> None:\n        \"\"\"Register street acronym variants into the inverted index.\"\"\"\n        variants = self.generate_street_variants(raw_name, district_codes, province_code)\n        for key, abbr in variants:\n            norm_key = normalize_ascii(key)\n            self.scoped_street_abbrs.setdefault(norm_key, []).append(abbr)\n\n    def _resolve_global_alias(\n        self,\n        norm_token: str,\n        stripped_token: str,\n    ) -> tuple[str, float, AbbrCategory] | None:\n        if norm_token in self.global_aliases:\n            canonical, conf = self.global_aliases[norm_token]\n            return canonical, conf, AbbrCategory.UNIVERSAL_STANDARD\n        if stripped_token in self.global_aliases:\n            canonical, conf = self.global_aliases[stripped_token]\n            return canonical, conf, AbbrCategory.UNIVERSAL_STANDARD\n        return None\n\n    @staticmethod\n    def _scoped_candidates_for_token(\n        scoped_index: dict[str, list[ScopedStreetAbbr]],\n        norm_token: str,\n        stripped_token: str,\n    ) -> list[ScopedStreetAbbr] | None:\n        return scoped_index.get(stripped_token) or scoped_index.get(norm_token)\n\n    @staticmethod\n            matched.canonical_name,\n            AbbrCategory.UNSCOPED_FALLBACK.default_confidence,\n            AbbrCategory.UNSCOPED_FALLBACK,\n        )\n\n    def _resolve_scoped_street(\n        self,\n        candidates: list[ScopedStreetAbbr],\n        *,\n        norm_token: str,\n        district_code: str | None,\n        province_code: str | None,\n        has_street_keyword: bool,\n    ) -> tuple[str, float, AbbrCategory] | None:\n        if district_code:\n            district_hit = self._resolve_district_scoped_match(\n                candidates,\n                district_code=district_code,\n                has_street_keyword=has_street_keyword,\n            )\n            if district_hit is not None:\n                return district_hit\n        if province_code:\n            province_hit = self._resolve_province_scoped_match(candidates, province_code)\n            if province_hit is not None:\n                return province_hit\n        return self._resolve_unique_unscoped_match(candidates, norm_token)\n\n    def resolve_street(\n        self,\n        token: str,\n        district_code: str | None = None,\n        province_code: str | None = None,\n        has_street_keyword: bool = False,\n    ) -> tuple[str, float, AbbrCategory] | None:\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_0835af5684698aa9016ae8448027588191958f0d05c70c2b5c"}},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '45,66p;340,368p;408,442p' vihap/cleaners/abbreviation_engine.py\", \"timeout\": 120000}"},"time":{"start":1793606784286,"end":1793606785414}}}}
