{"type":"tool_use","timestamp":1793607110277,"sessionID":"ses_util_oc_kgx_r2_F1","part":{"partID":"prt_19b5085c4001yfAbraidYbuyWU","sessionID":"ses_util_oc_kgx_r2_F1","messageID":"msg_19b5070aa001jxiKnX91aIIDTK","type":"tool","id":"call_fc45e0cc88034231af285f1849f2dd61","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '110,147p' tests/test_scoring_sklearn_api.py; sed -n '150,174p' vihap/matching/similarity.py; sed -n '260,365p' vihap/matching/similarity.py; sed -n '42,53p' vihap/cleaners/unicode.py","workdir":"/tmp/prosev-new"},"output":"        \"72 Lê Thánh Tôn, Bến Nghé, Quận 1, TP.HCM\",\n        \"Số 12 Lê Duẩn, Đống Đa, Hà Nội\",\n    ]\n    addresses_y = [\n        \"72 Lê Thánh Tôn, Quận 1, HCM\",\n        \"12 Lê Duẩn, Hà Nội\",\n        \"Cầu Giấy, Hà Nội\",\n    ]\n\n    # Symmetric N x N\n    mat_sym = pairwise_address_similarity(addresses_x, metric=\"hybrid\", normalize=True)\n    assert isinstance(mat_sym, np.ndarray)\n    assert mat_sym.shape == (2, 2)\n    assert mat_sym.dtype == np.float32\n    assert mat_sym[0, 0] == 1.0\n    assert mat_sym[1, 1] == 1.0\n\n    # Rectangular N x M\n    mat_rect = pairwise_address_similarity(addresses_x, addresses_y, metric=\"token\", normalize=True)\n    assert isinstance(mat_rect, np.ndarray)\n    assert mat_rect.shape == (2, 3)\n    assert mat_rect[0, 0] >= 0.85\n    assert mat_rect[1, 1] >= 0.85\n\n    # Street metric (symmetric and rectangular)\n    streets_x = [\"Đường Nguyễn Trãi\", \"Đường 10\"]\n    streets_y = [\"Phố Nguyễn Trãi\", \"Đường 12\", \"Lê Lợi\"]\n    mat_st_sym = pairwise_address_similarity(streets_x, metric=\"street\", normalize=True)\n    assert mat_st_sym.shape == (2, 2)\n    assert mat_st_sym[0, 0] == 1.0\n    assert mat_st_sym[1, 1] == 1.0\n\n    mat_st_rect = pairwise_address_similarity(streets_x, streets_y, metric=\"street\", normalize=True)\n    assert mat_st_rect.shape == (2, 3)\n    assert mat_st_rect[0, 0] == 1.0  # Nguyễn Trãi vs Phố Nguyễn Trãi\n    assert mat_st_rect[1, 1] == 0.0  # Đường 10 vs Đường 12 (disjoint digits)\n\n\n    \"\"\"Check if shorter string is a word-boundary delimited substring of longer.\"\"\"\n    tokens = shorter.split()\n    if len(tokens) >= 2 or len(shorter) >= 8:\n        if build_substring_boundary_pattern(shorter).search(longer):\n            return True\n    return False\n\n\ndef evaluate_street_similarity(\n    name_a: str | None,\n    name_b: str | None,\n    threshold: float = 0.82,\n) -> float:\n    \"\"\"Compute street name similarity incorporating prefix stripping, digit lock, and word boundaries.\n\n    Parameters\n    ----------\n    name_a : str or None\n        First street name (e.g., declared street).\n    name_b : str or None\n        Second street name (e.g., candidate OSM road name).\n    threshold : float, default=0.82\n        Decision threshold for near-miss floor penalty.\n\n    Returns\n    if norm_a == norm_b:\n        return 1.0\n    s_set = fuzz.token_set_ratio(norm_a, norm_b)\n    s_sort = fuzz.token_sort_ratio(norm_a, norm_b)\n    return round(max(s_set, s_sort) / 100.0, 4)\n\n\ndef pairwise_address_similarity(\n    X: Sequence[str],\n    Y: Sequence[str] | None = None,\n    *,\n    metric: Literal[\"hybrid\", \"token\", \"levenshtein\", \"street\"] | str = \"hybrid\",\n    alpha: float = 0.70,\n    normalize: bool = True,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise address similarity matrix adhering to scikit-learn pairwise kernel conventions.\n\n    Args:\n        X: Sequence of address strings of length N.\n        Y: Optional sequence of address strings of length M. If None, computes pairwise similarity\n           of X against itself (symmetric N x N).\n        metric: Similarity metric to use: 'hybrid' (blended token + Levenshtein),\n                'token' (token set ratio), 'levenshtein' (raw Levenshtein edit ratio),\n                or 'street' (street name similarity with digit lock).\n        alpha: Weight for token similarity when metric='hybrid' (default: 0.70).\n        normalize: If True (default), normalizes scores to range [0.0, 1.0].\n                   If False, returns raw percentage scores [0.0, 100.0].\n\n    Returns:\n        2D numpy array of shape (len(X), len(Y or X)) with float32 similarity values.\n    \"\"\"\n    if len(X) == 0:\n        y_len = len(X) if Y is None else len(Y)\n        return np.zeros((0, y_len), dtype=np.float32)\n\n    norm_x = [normalize_ascii(x).strip(\" ,-\") for x in X]\n    norm_y = norm_x if Y is None else [normalize_ascii(y).strip(\" ,-\") for y in Y]\n\n    if len(norm_y) == 0:\n        return np.zeros((len(norm_x), 0), dtype=np.float32)\n\n    if metric == \"token\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"levenshtein\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"hybrid\":\n        raw_token = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n        raw_lev = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n        raw = (alpha * raw_token + (1.0 - alpha) * raw_lev).astype(np.float32)\n    elif metric == \"street\":\n        x_list = list(X)\n        y_list = x_list if Y is None else list(Y)\n        raw = np.empty((len(x_list), len(y_list)), dtype=np.float32)\n        if Y is None:\n            n = len(x_list)\n            for i in range(n):\n                raw[i, i] = evaluate_street_similarity(x_list[i], x_list[i])\n                for j in range(i + 1, n):\n                    s = evaluate_street_similarity(x_list[i], x_list[j])\n                    raw[i, j] = s\n                    raw[j, i] = s\n        else:\n            for i, x in enumerate(x_list):\n                for j, y in enumerate(y_list):\n                    raw[i, j] = evaluate_street_similarity(x, y)\n        return raw if normalize else (raw * 100.0).astype(np.float32)\n    else:\n        raise ValueError(\n            f\"Unknown metric {metric!r}. Expected 'hybrid', 'token', 'levenshtein', or 'street'.\"\n        )\n\n    return (raw / 100.0).astype(np.float32) if normalize else raw\n\n\ndef compute_similarity_matrix(\n    queries: Sequence[str],\n    choices: Sequence[str],\n    *,\n    normalize: bool = False,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise similarity matrix using vectorized batch execution.\n\n    Delegates to :func:`pairwise_address_similarity` with metric='token'.\n    \"\"\"\n    return pairwise_address_similarity(queries, choices, metric=\"token\", normalize=normalize)\n\n\n@overload\ndef address_similarity_score(\n    X: str,\n    Y: str,\n    *,\n    metric: Literal[\"hybrid\", \"token\", \"levenshtein\", \"street\"] | str = \"hybrid\",\n    alpha: float = 0.70,\n                mapping[char] = base\n    return cast(dict[int, int | str | None], str.maketrans(mapping))\n\n\n@functools.lru_cache(maxsize=32768)\ndef normalize_ascii(text: str | None) -> str:\n    \"\"\"Normalize string to lowercase, strip diacritics and convert đ/Đ to d.\"\"\"\n    if not text:\n        return \"\"\n    raw = str(text)\n    if raw.isascii():\n        return raw.lower().strip()\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"        \"72 Lê Thánh Tôn, Bến Nghé, Quận 1, TP.HCM\",\n        \"Số 12 Lê Duẩn, Đống Đa, Hà Nội\",\n    ]\n    addresses_y = [\n        \"72 Lê Thánh Tôn, Quận 1, HCM\",\n        \"12 Lê Duẩn, Hà Nội\",\n        \"Cầu Giấy, Hà Nội\",\n    ]\n\n    # Symmetric N x N\n    mat_sym = pairwise_address_similarity(addresses_x, metric=\"hybrid\", normalize=True)\n    assert isinstance(mat_sym, np.ndarray)\n    assert mat_sym.shape == (2, 2)\n    assert mat_sym.dtype == np.float32\n    assert mat_sym[0, 0] == 1.0\n    assert mat_sym[1, 1] == 1.0\n\n    # Rectangular N x M\n    mat_rect = pairwise_address_similarity(addresses_x, addresses_y, metric=\"token\", normalize=True)\n    assert isinstance(mat_rect, np.ndarray)\n    assert mat_rect.shape == (2, 3)\n    assert mat_rect[0, 0] >= 0.85\n    assert mat_rect[1, 1] >= 0.85\n\n    # Street metric (symmetric and rectangular)\n    streets_x = [\"Đường Nguyễn Trãi\", \"Đường 10\"]\n    streets_y = [\"Phố Nguyễn Trãi\", \"Đường 12\", \"Lê Lợi\"]\n    mat_st_sym = pairwise_address_similarity(streets_x, metric=\"street\", normalize=True)\n    assert mat_st_sym.shape == (2, 2)\n    assert mat_st_sym[0, 0] == 1.0\n    assert mat_st_sym[1, 1] == 1.0\n\n    mat_st_rect = pairwise_address_similarity(streets_x, streets_y, metric=\"street\", normalize=True)\n    assert mat_st_rect.shape == (2, 3)\n    assert mat_st_rect[0, 0] == 1.0  # Nguyễn Trãi vs Phố Nguyễn Trãi\n    assert mat_st_rect[1, 1] == 0.0  # Đường 10 vs Đường 12 (disjoint digits)\n\n\n    \"\"\"Check if shorter string is a word-boundary delimited substring of longer.\"\"\"\n    tokens = shorter.split()\n    if len(tokens) >= 2 or len(shorter) >= 8:\n        if build_substring_boundary_pattern(shorter).search(longer):\n            return True\n    return False\n\n\ndef evaluate_street_similarity(\n    name_a: str | None,\n    name_b: str | None,\n    threshold: float = 0.82,\n) -> float:\n    \"\"\"Compute street name similarity incorporating prefix stripping, digit lock, and word boundaries.\n\n    Parameters\n    ----------\n    name_a : str or None\n        First street name (e.g., declared street).\n    name_b : str or None\n        Second street name (e.g., candidate OSM road name).\n    threshold : float, default=0.82\n        Decision threshold for near-miss floor penalty.\n\n    Returns\n    if norm_a == norm_b:\n        return 1.0\n    s_set = fuzz.token_set_ratio(norm_a, norm_b)\n    s_sort = fuzz.token_sort_ratio(norm_a, norm_b)\n    return round(max(s_set, s_sort) / 100.0, 4)\n\n\ndef pairwise_address_similarity(\n    X: Sequence[str],\n    Y: Sequence[str] | None = None,\n    *,\n    metric: Literal[\"hybrid\", \"token\", \"levenshtein\", \"street\"] | str = \"hybrid\",\n    alpha: float = 0.70,\n    normalize: bool = True,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise address similarity matrix adhering to scikit-learn pairwise kernel conventions.\n\n    Args:\n        X: Sequence of address strings of length N.\n        Y: Optional sequence of address strings of length M. If None, computes pairwise similarity\n           of X against itself (symmetric N x N).\n        metric: Similarity metric to use: 'hybrid' (blended token + Levenshtein),\n                'token' (token set ratio), 'levenshtein' (raw Levenshtein edit ratio),\n                or 'street' (street name similarity with digit lock).\n        alpha: Weight for token similarity when metric='hybrid' (default: 0.70).\n        normalize: If True (default), normalizes scores to range [0.0, 1.0].\n                   If False, returns raw percentage scores [0.0, 100.0].\n\n    Returns:\n        2D numpy array of shape (len(X), len(Y or X)) with float32 similarity values.\n    \"\"\"\n    if len(X) == 0:\n        y_len = len(X) if Y is None else len(Y)\n        return np.zeros((0, y_len), dtype=np.float32)\n\n    norm_x = [normalize_ascii(x).strip(\" ,-\") for x in X]\n    norm_y = norm_x if Y is None else [normalize_ascii(y).strip(\" ,-\") for y in Y]\n\n    if len(norm_y) == 0:\n        return np.zeros((len(norm_x), 0), dtype=np.float32)\n\n    if metric == \"token\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"levenshtein\":\n        raw = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n    elif metric == \"hybrid\":\n        raw_token = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.token_set_ratio),\n            dtype=np.float32,\n        )\n        raw_lev = np.asarray(\n            process.cdist(norm_x, norm_y, scorer=fuzz.ratio),\n            dtype=np.float32,\n        )\n        raw = (alpha * raw_token + (1.0 - alpha) * raw_lev).astype(np.float32)\n    elif metric == \"street\":\n        x_list = list(X)\n        y_list = x_list if Y is None else list(Y)\n        raw = np.empty((len(x_list), len(y_list)), dtype=np.float32)\n        if Y is None:\n            n = len(x_list)\n            for i in range(n):\n                raw[i, i] = evaluate_street_similarity(x_list[i], x_list[i])\n                for j in range(i + 1, n):\n                    s = evaluate_street_similarity(x_list[i], x_list[j])\n                    raw[i, j] = s\n                    raw[j, i] = s\n        else:\n            for i, x in enumerate(x_list):\n                for j, y in enumerate(y_list):\n                    raw[i, j] = evaluate_street_similarity(x, y)\n        return raw if normalize else (raw * 100.0).astype(np.float32)\n    else:\n        raise ValueError(\n            f\"Unknown metric {metric!r}. Expected 'hybrid', 'token', 'levenshtein', or 'street'.\"\n        )\n\n    return (raw / 100.0).astype(np.float32) if normalize else raw\n\n\ndef compute_similarity_matrix(\n    queries: Sequence[str],\n    choices: Sequence[str],\n    *,\n    normalize: bool = False,\n) -> NDArray[np.float32]:\n    \"\"\"Compute pairwise similarity matrix using vectorized batch execution.\n\n    Delegates to :func:`pairwise_address_similarity` with metric='token'.\n    \"\"\"\n    return pairwise_address_similarity(queries, choices, metric=\"token\", normalize=normalize)\n\n\n@overload\ndef address_similarity_score(\n    X: str,\n    Y: str,\n    *,\n    metric: Literal[\"hybrid\", \"token\", \"levenshtein\", \"street\"] | str = \"hybrid\",\n    alpha: float = 0.70,\n                mapping[char] = base\n    return cast(dict[int, int | str | None], str.maketrans(mapping))\n\n\n@functools.lru_cache(maxsize=32768)\ndef normalize_ascii(text: str | None) -> str:\n    \"\"\"Normalize string to lowercase, strip diacritics and convert đ/Đ to d.\"\"\"\n    if not text:\n        return \"\"\n    raw = str(text)\n    if raw.isascii():\n        return raw.lower().strip()\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_0604f60f54a178ed016ae845c3fc6081918d88517c060545aa"}},"providerResult":{"executed":false},"rawInput":"{\"command\":\"sed -n '110,147p' tests/test_scoring_sklearn_api.py; sed -n '150,174p' vihap/matching/similarity.py; sed -n '260,365p' vihap/matching/similarity.py; sed -n '42,53p' vihap/cleaners/unicode.py\",\"workdir\":\"/tmp/prosev-new\"}"},"time":{"start":1793607108036,"end":1793607110277}}}}
