g, ts: u64) -> String {\nsrc/journal.rs:432 src.journal.payload_stats pub fn payload_stats(root: &Path) -> (usize, u64) {\nsrc/journal.rs:417 src.journal.read_payload_log fn read_payload_log(root: &Path) -> String {\nsrc/journal.rs:24 src.journal.payload_log_path pub fn payload_log_path(root: &Path) -> PathBuf {\nsrc/query.rs:1057 src.query.record_payload_capture fn record_payload_capture(conn: &Connection, name: &str, out: &QueryOutput) {\nsrc/journal.rs:379 src.journal.parse_payload_line fn parse_payload_line(line: &str) -> Option<(String, String, u64, Vec<String>)> {\nsrc/journal.rs:602 src.journal.payload_line_is_self_contained_and_escaped fn payload_line_is_self_contained_and_escaped() {\ntests/cli.rs:813 tests.cli.payload_log_written_for_pointer_tools_only fn payload_log_written_for_pointer_tools_only() {\ntests/cli.rs:906 tests.cli.payload_opt_out_and_empty_or_ambiguous_writes_none fn payload_opt_out_and_empty_or_ambiguous_writes_none() {\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_07a8caecc568f1dd016ae83fb361cc8191947d50b0e1bfa87e"}},"providerResult":{"executed":false},"rawInput":"{\"command\":\"/Users/quy.doan/Workspace/kg/target/release/kg --root /tmp/prose-new search 'usage payload pointers'\",\"workdir\":\"/tmp/prose-new\"}"},"time":{"start":1793605555424,"end":1793605555960}}}}
