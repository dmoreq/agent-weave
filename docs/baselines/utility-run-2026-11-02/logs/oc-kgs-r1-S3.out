{"type":"tool_use","timestamp":1793584998357,"sessionID":"ses_util_oc_kgs_r1_S3","part":{"partID":"prt_199ff2601001CJGS05XEbtBNJE","sessionID":"ses_util_oc_kgs_r1_S3","messageID":"msg_199ff1bf6001JBHcH8nHsWsC0J","type":"tool","id":"call_d9afa44a97b543f19df4f97280aeebe3","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/utility-corpus-2026-11-02/vihap/vihap/cleaners/unicode.py","offset":1,"limit":88},"output":"Read file /private/tmp/utility-corpus-2026-11-02/vihap/vihap/cleaners/unicode.py, lines 1-55\n1: \"\"\"Zero-dependency Unicode normalization and ASCII transliteration primitives.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import functools\n6: import unicodedata\n7: from typing import cast\n8: \n9: __all__ = [\n10:     \"normalize_ascii\",\n11:     \"normalize_unicode_nfkc\",\n12: ]\n13: \n14: \n15: def normalize_unicode_nfkc(text: str) -> str:\n16:     \"\"\"Normalize unicode to NFKC (converts mathematical/stylized Unicode to standard alphanumerics).\"\"\"\n17:     if not text:\n18:         return \"\"\n19:     return unicodedata.normalize(\"NFKC\", text)\n20: \n21: \n22: @functools.lru_cache(maxsize=1)\n23: def _ascii_diacritic_trans() -> dict[int, int | str | None]:\n24:     \"\"\"Build a C-accelerated translate table mirroring NFD + Mn-stripping + đ→d.\"\"\"\n25:     mapping: dict[str, str | None] = {\"đ\": \"d\", \"Đ\": \"d\"}\n26:     # Scan relevant Latin, Vietnamese, Combining Diacritics, and Fullwidth blocks\n27:     ranges = (\n28:         range(0x0000, 0x2500),\n29:         range(0x1DC0, 0x2000),\n30:         range(0x20D0, 0x2100),\n31:         range(0xFE20, 0xFE30),\n32:         range(0xFF00, 0xFFF0),\n33:     )\n34:     for r in ranges:\n35:         for char in map(chr, r):\n36:             if unicodedata.category(char) == \"Mn\":\n37:                 mapping[char] = None\n38:                 continue\n39:             decomposed = unicodedata.normalize(\"NFD\", char)\n40:             base = \"\".join(c for c in decomposed if unicodedata.category(c) != \"Mn\")\n41:             if len(base) == 1 and base != char:\n42:                 mapping[char] = base\n43:     return cast(dict[int, int | str | None], str.maketrans(mapping))\n44: \n45: \n46: @functools.lru_cache(maxsize=32768)\n47: def normalize_ascii(text: str | None) -> str:\n48:     \"\"\"Normalize string to lowercase, strip diacritics and convert đ/Đ to d.\"\"\"\n49:     if not text:\n50:         return \"\"\n51:     raw = str(text)\n52:     if raw.isascii():\n53:         return raw.lower().strip()\n54:     normalized = unicodedata.normalize(\"NFKC\", raw.lower().strip())\n55:     return normalized.translate(_ascii_diacritic_trans())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/utility-corpus-2026-11-02/vihap/vihap/cleaners/unicode.py, lines 1-55\n1: \"\"\"Zero-dependency Unicode normalization and ASCII transliteration primitives.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import functools\n6: import unicodedata\n7: from typing import cast\n8: \n9: __all__ = [\n10:     \"normalize_ascii\",\n11:     \"normalize_unicode_nfkc\",\n12: ]\n13: \n14: \n15: def normalize_unicode_nfkc(text: str) -> str:\n16:     \"\"\"Normalize unicode to NFKC (converts mathematical/stylized Unicode to standard alphanumerics).\"\"\"\n17:     if not text:\n18:         return \"\"\n19:     return unicodedata.normalize(\"NFKC\", text)\n20: \n21: \n22: @functools.lru_cache(maxsize=1)\n23: def _ascii_diacritic_trans() -> dict[int, int | str | None]:\n24:     \"\"\"Build a C-accelerated translate table mirroring NFD + Mn-stripping + đ→d.\"\"\"\n25:     mapping: dict[str, str | None] = {\"đ\": \"d\", \"Đ\": \"d\"}\n26:     # Scan relevant Latin, Vietnamese, Combining Diacritics, and Fullwidth blocks\n27:     ranges = (\n28:         range(0x0000, 0x2500),\n29:         range(0x1DC0, 0x2000),\n30:         range(0x20D0, 0x2100),\n31:         range(0xFE20, 0xFE30),\n32:         range(0xFF00, 0xFFF0),\n33:     )\n34:     for r in ranges:\n35:         for char in map(chr, r):\n36:             if unicodedata.category(char) == \"Mn\":\n37:                 mapping[char] = None\n38:                 continue\n39:             decomposed = unicodedata.normalize(\"NFD\", char)\n40:             base = \"\".join(c for c in decomposed if unicodedata.category(c) != \"Mn\")\n41:             if len(base) == 1 and base != char:\n42:                 mapping[char] = base\n43:     return cast(dict[int, int | str | None], str.maketrans(mapping))\n44: \n45: \n46: @functools.lru_cache(maxsize=32768)\n47: def normalize_ascii(text: str | None) -> str:\n48:     \"\"\"Normalize string to lowercase, strip diacritics and convert đ/Đ to d.\"\"\"\n49:     if not text:\n50:         return \"\"\n51:     raw = str(text)\n52:     if raw.isascii():\n53:         return raw.lower().strip()\n54:     normalized = unicodedata.normalize(\"NFKC\", raw.lower().strip())\n55:     return normalized.translate(_ascii_diacritic_trans())"}],"providerCall":{"executed":false,"state":{"itemId":"fc_0d96da160735a379016ae7ef65d4988191b2e39ab7fcf69736"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/utility-corpus-2026-11-02/vihap/vihap/cleaners/unicode.py\",\"offset\":1,\"limit\":88}"},"time":{"start":1793584997889,"end":1793584998357}}}}
