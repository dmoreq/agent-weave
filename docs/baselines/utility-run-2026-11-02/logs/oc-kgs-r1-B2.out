t\"),\n149:                 \"lon\": _comp(\"lon\"),\n150:                 \"is_street_verified\": _comp(\"is_street_verified\"),\n151:             }\n152:         )\n153:     if include_gso_codes:\n154:         data.update(\n155:             {\n156:                 \"gso_ward_code\": _gso(\"ward_code\"),\n157:                 \"gso_district_code\": _gso(\"district_code\"),\n158:                 \"gso_province_code\": _gso(\"province_code\"),\n159:             }\n160:         )\n161:     if include_scores:\n162:         data[\"quality_score\"] = [item.quality_score for item in parsed]\n163: \n164:     data[\"is_admin_verified\"] = [item.is_admin_verified for item in parsed]\n165:     data[\"formatted_standard\"] = [item.formatted_standard for item in parsed]\n166: \n167:     return pa.table(data)\n168: \n169: \n170: def _pair_rows_from_matrix(\n171:     rows: Any,\n172:     *,\n173:     poi_col: str,\n174:     category_col: str,\n175: ) -> list[dict[str, Any]]:\n176:     return [{poi_col: str(row[0]), category_col: str(row[1])} for row in rows]\n177: \n178: \n179: def _rows_from_numpy_array(\n180:     X: np.ndarray,\n181:     *,\n182:     poi_col: str,\n183:     category_col: str,\n184: ) -> list[dict[str, Any]] | None:\n185:     if X.ndim == 2 and X.shape[1] >= 2:\n186:         return _pair_rows_from_matrix(X, poi_col=poi_col, category_col=category_col)\n187:     if X.ndim == 1:\n188:         return [{poi_col: str(item), category_col: \"\"} for item in X]\n189:     return None\n190: \n191: \n192: def _rows_from_list_input(\n193:     X: list[Any],\n194:     *,\n195:     poi_col: str,\n196:     category_col: str,\n197: ) -> list[dict[str, Any]]:\n198:     if X and isinstance(X[0], (list, tuple)) and len(X[0]) >= 2:\n199:         return _pair_rows_from_matrix(X, poi_col=poi_col, category_col=category_col)\n200:     return X\n201: \n202: \n203: def _extract_tabular_rows(X: Any, poi_col: str, category_col: str) -> list[dict[str, Any]]:\n204:     \"\"\"Extract row dicts 