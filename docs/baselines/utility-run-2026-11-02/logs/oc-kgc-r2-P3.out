{"type":"tool_use","timestamp":1793582000008,"sessionID":"ses_util_oc_kgc_r2_P3","part":{"partID":"prt_199d1671d001dnbk8Ffw19Af2F","sessionID":"ses_util_oc_kgc_r2_P3","messageID":"msg_199d149600019Emr4uuNen6IrH","type":"tool","id":"call_f35740784a054fc6898da38308bea86e","tool":"shell","state":{"status":"completed","input":{"command":"/Users/quy.doan/Workspace/kg/target/release/kg --root /tmp/utility-corpus-2026-11-02/vihap callees scripts.build_knowledge_base.export_master_admin_marshal --depth 1 --limit 200 | rg '1423|1430|1431|1432|1439|1458|1459'","timeout":120000},"output":"(no output)","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":1},"content":[{"type":"text","text":"(no output)"},{"type":"text","text":"Exited with code 1"}],"providerCall":{"executed":false,"state":{"itemId":"fc_06004e075d6ae096016ae7e3afbed081919a2b81550795672f"}},"providerResult":{"executed":false},"rawInput":"{\"command\": \"/Users/quy.doan/Workspace/kg/target/release/kg --root /tmp/utility-corpus-2026-11-02/vihap callees scripts.build_knowledge_base.export_master_admin_marshal --depth 1 --limit 200 | rg '1423|1430|1431|1432|1439|1458|1459'\", \"timeout\": 120000}"},"time":{"start":1793581999901,"end":1793582000008}}}}
{"type":"tool_use","timestamp":1793582000026,"sessionID":"ses_util_oc_kgc_r2_P3","part":{"partID":"prt_199d1671b00140Qam9OsmMotwU","sessionID":"ses_util_oc_kgc_r2_P3","messageID":"msg_199d149600019Emr4uuNen6IrH","type":"tool","id":"call_4185085ec7ca4659894c228b73e4c7e3","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '205,240p' vihap/cleaners/text_utils.py; sed -n '1,65p' vihap/cleaners/unicode.py; sed -n '1,47p' scripts/build_knowledge_base.py","workdir":"/tmp/utility-corpus-2026-11-02/vihap"},"output":"    return \"\".join(\" \" if unicodedata.category(c) == \"Co\" else c for c in raw)\n\n\ndef protect_highway_dashes(text: str) -> str:\n    \"\"\"Replace intra-route hyphens in expressway names with a private-use placeholder.\"\"\"\n\n    def _repl(match: re.Match[str]) -> str:\n        prefix = match.group(1)\n        route = _HWY_INNER_DASH_RE.sub(_HWY_DASH_PLACEHOLDER, match.group(2))\n        return f\"{prefix}{route}\"\n\n    return _HWY_ROUTE_RE.sub(_repl, text)\n\n\ndef restore_highway_dashes(text: str) -> str:\n    \"\"\"Restore expressway route hyphens from placeholder.\"\"\"\n    return text.replace(_HWY_DASH_PLACEHOLDER, \" - \")\n\n\ndef collapse_whitespace(text: str) -> str:\n    \"\"\"Collapse repeated whitespace runs to a single space, normalize slashes, and strip edges.\"\"\"\n    if not text:\n        return \"\"\n    has_slash = \"/\" in text\n    if not has_slash and \"  \" not in text and \"\\t\" not in text and \"\\n\" not in text:\n        return normalize_unicode_nfkc(text.strip())\n    cleaned = normalize_unicode_nfkc(text)\n    return \" \".join((normalize_slash_numbers(cleaned) if has_slash else cleaned).split())\n\n\ndef normalize_regional_street(street_name: str | None) -> str:\n    \"\"\"Normalize regional street shorthand (e.g. Da Nang 'K12' -> 'Kiệt 12', spacing).\n\n    Applies Da Nang ``K``/``K.`` lane shorthand expansion and conjoined number spacing\n    (e.g. ``ngõ45`` -> ``ngõ 45``).\n    \"\"\"\n\"\"\"Zero-dependency Unicode normalization and ASCII transliteration primitives.\"\"\"\n\nfrom __future__ import annotations\n\nimport functools\nimport unicodedata\nfrom typing import cast\n\n__all__ = [\n    \"normalize_ascii\",\n    \"normalize_unicode_nfkc\",\n]\n\n\ndef normalize_unicode_nfkc(text: str) -> str:\n    \"\"\"Normalize unicode to NFKC (converts mathematical/stylized Unicode to standard alphanumerics).\"\"\"\n    if not text:\n        return \"\"\n    return unicodedata.normalize(\"NFKC\", text)\n\n\n@functools.lru_cache(maxsize=1)\ndef _ascii_diacritic_trans() -> dict[int, int | str | None]:\n    \"\"\"Build a C-accelerated translate table mirroring NFD + Mn-stripping + đ→d.\"\"\"\n    mapping: dict[str, str | None] = {\"đ\": \"d\", \"Đ\": \"d\"}\n    # Scan relevant Latin, Vietnamese, Combining Diacritics, and Fullwidth blocks\n    ranges = (\n        range(0x0000, 0x2500),\n        range(0x1DC0, 0x2000),\n        range(0x20D0, 0x2100),\n        range(0xFE20, 0xFE30),\n        range(0xFF00, 0xFFF0),\n    )\n    for r in ranges:\n        for char in map(chr, r):\n            if unicodedata.category(char) == \"Mn\":\n                mapping[char] = None\n                continue\n            decomposed = unicodedata.normalize(\"NFD\", char)\n            base = \"\".join(c for c in decomposed if unicodedata.category(c) != \"Mn\")\n            if len(base) == 1 and base != char:\n                mapping[char] = base\n    return cast(dict[int, int | str | None], str.maketrans(mapping))\n\n\n@functools.lru_cache(maxsize=32768)\ndef normalize_ascii(text: str | None) -> str:\n    \"\"\"Normalize string to lowercase, strip diacritics and convert đ/Đ to d.\"\"\"\n    if not text:\n        return \"\"\n    raw = str(text)\n    if raw.isascii():\n        return raw.lower().strip()\n    normalized = unicodedata.normalize(\"NFKC\", raw.lower().strip())\n    return normalized.translate(_ascii_diacritic_trans())\n#!/usr/bin/env python3\n\"\"\"Unified Knowledge Base Builder for VIHAP.\n\nBuilds and packages administrative hierarchies, streets, buildings, and reform mappings:\n1. master_admin.json — Canonical JSON representation of 3-tier & 2-tier administrative tree.\n2. master_admin.sqlite — High-performance relational database with indices.\n3. master_admin.marshal.xz — LZMA compressed runtime knowledge base for vihap.\n\nUsage:\n  python3 scripts/build_knowledge_base.py --all\n  python3 scripts/build_knowledge_base.py --sqlite\n  python3 scripts/build_knowledge_base.py --json\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport lzma\nimport marshal\nimport sqlite3\nimport unicodedata\nfrom pathlib import Path\nfrom typing import Any\n\ntry:\n    import vietnam_provinces.legacy as leg\nexcept (ImportError, AttributeError):\n    try:\n        import vietnam_provinces as leg  # type: ignore[no-redef]\n    except ImportError:\n        leg = None  # type: ignore[assignment]\nfrom loguru import logger\nfrom vietnam_provinces import NESTED_DIVISIONS_JSON_PATH\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nSOURCES_DIR = REPO_ROOT / \"data\" / \"sources\"\nARTIFACTS_DIR_PY = REPO_ROOT / \"vihap\" / \"artifacts\"\n\nOUTPUT_JSON = SOURCES_DIR / \"master_admin.json\"\nOUTPUT_SQLITE = REPO_ROOT / \"data\" / \"master_admin.sqlite\"\nOUTPUT_MARSHAL_PY = ARTIFACTS_DIR_PY / \"master_admin.marshal\"\nOUTPUT_MARSHAL_XZ_PY = ARTIFACTS_DIR_PY / \"master_admin.marshal.xz\"\nMARSHAL_SCHEMA_VERSION = 2\n\nADMIN_DICT_DIR = REPO_ROOT / \"data\" / \"admin_dictionary\"\nADMIN_2TIER_PATH = ADMIN_DICT_DIR / \"2tier_admin_dictionary.csv\"\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    return \"\".join(\" \" if unicodedata.category(c) == \"Co\" else c for c in raw)\n\n\ndef protect_highway_dashes(text: str) -> str:\n    \"\"\"Replace intra-route hyphens in expressway names with a private-use placeholder.\"\"\"\n\n    def _repl(match: re.Match[str]) -> str:\n        prefix = match.group(1)\n        route = _HWY_INNER_DASH_RE.sub(_HWY_DASH_PLACEHOLDER, match.group(2))\n        return f\"{prefix}{route}\"\n\n    return _HWY_ROUTE_RE.sub(_repl, text)\n\n\ndef restore_highway_dashes(text: str) -> str:\n    \"\"\"Restore expressway route hyphens from placeholder.\"\"\"\n    return text.replace(_HWY_DASH_PLACEHOLDER, \" - \")\n\n\ndef collapse_whitespace(text: str) -> str:\n    \"\"\"Collapse repeated whitespace runs to a single space, normalize slashes, and strip edges.\"\"\"\n    if not text:\n        return \"\"\n    has_slash = \"/\" in text\n    if not has_slash and \"  \" not in text and \"\\t\" not in text and \"\\n\" not in text:\n        return normalize_unicode_nfkc(text.strip())\n    cleaned = normalize_unicode_nfkc(text)\n    return \" \".join((normalize_slash_numbers(cleaned) if has_slash else cleaned).split())\n\n\ndef normalize_regional_street(street_name: str | None) -> str:\n    \"\"\"Normalize regional street shorthand (e.g. Da Nang 'K12' -> 'Kiệt 12', spacing).\n\n    Applies Da Nang ``K``/``K.`` lane shorthand expansion and conjoined number spacing\n    (e.g. ``ngõ45`` -> ``ngõ 45``).\n    \"\"\"\n\"\"\"Zero-dependency Unicode normalization and ASCII transliteration primitives.\"\"\"\n\nfrom __future__ import annotations\n\nimport functools\nimport unicodedata\nfrom typing import cast\n\n__all__ = [\n    \"normalize_ascii\",\n    \"normalize_unicode_nfkc\",\n]\n\n\ndef normalize_unicode_nfkc(text: str) -> str:\n    \"\"\"Normalize unicode to NFKC (converts mathematical/stylized Unicode to standard alphanumerics).\"\"\"\n    if not text:\n        return \"\"\n    return unicodedata.normalize(\"NFKC\", text)\n\n\n@functools.lru_cache(maxsize=1)\ndef _ascii_diacritic_trans() -> dict[int, int | str | None]:\n    \"\"\"Build a C-accelerated translate table mirroring NFD + Mn-stripping + đ→d.\"\"\"\n    mapping: dict[str, str | None] = {\"đ\": \"d\", \"Đ\": \"d\"}\n    # Scan relevant Latin, Vietnamese, Combining Diacritics, and Fullwidth blocks\n    ranges = (\n        range(0x0000, 0x2500),\n        range(0x1DC0, 0x2000),\n        range(0x20D0, 0x2100),\n        range(0xFE20, 0xFE30),\n        range(0xFF00, 0xFFF0),\n    )\n    for r in ranges:\n        for char in map(chr, r):\n            if unicodedata.category(char) == \"Mn\":\n                mapping[char] = None\n                continue\n            decomposed = unicodedata.normalize(\"NFD\", char)\n            base = \"\".join(c for c in decomposed if unicodedata.category(c) != \"Mn\")\n            if len(base) == 1 and base != char:\n                mapping[char] = base\n    return cast(dict[int, int | str | None], str.maketrans(mapping))\n\n\n@functools.lru_cache(maxsize=32768)\ndef normalize_ascii(text: str | None) -> str:\n    \"\"\"Normalize string to lowercase, strip diacritics and convert đ/Đ to d.\"\"\"\n    if not text:\n        return \"\"\n    raw = str(text)\n    if raw.isascii():\n        return raw.lower().strip()\n    normalized = unicodedata.normalize(\"NFKC\", raw.lower().strip())\n    return normalized.translate(_ascii_diacritic_trans())\n#!/usr/bin/env python3\n\"\"\"Unified Knowledge Base Builder for VIHAP.\n\nBuilds and packages administrative hierarchies, streets, buildings, and reform mappings:\n1. master_admin.json — Canonical JSON representation of 3-tier & 2-tier administrative tree.\n2. master_admin.sqlite — High-performance relational database with indices.\n3. master_admin.marshal.xz — LZMA compressed runtime knowledge base for vihap.\n\nUsage:\n  python3 scripts/build_knowledge_base.py --all\n  python3 scripts/build_knowledge_base.py --sqlite\n  python3 scripts/build_knowledge_base.py --json\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport lzma\nimport marshal\nimport sqlite3\nimport unicodedata\nfrom pathlib import Path\nfrom typing import Any\n\ntry:\n    import vietnam_provinces.legacy as leg\nexcept (ImportError, AttributeError):\n    try:\n        import vietnam_provinces as leg  # type: ignore[no-redef]\n    except ImportError:\n        leg = None  # type: ignore[assignment]\nfrom loguru import logger\nfrom vietnam_provinces import NESTED_DIVISIONS_JSON_PATH\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nSOURCES_DIR = REPO_ROOT / \"data\" / \"sources\"\nARTIFACTS_DIR_PY = REPO_ROOT / \"vihap\" / \"artifacts\"\n\nOUTPUT_JSON = SOURCES_DIR / \"master_admin.json\"\nOUTPUT_SQLITE = REPO_ROOT / \"data\" / \"master_admin.sqlite\"\nOUTPUT_MARSHAL_PY = ARTIFACTS_DIR_PY / \"master_admin.marshal\"\nOUTPUT_MARSHAL_XZ_PY = ARTIFACTS_DIR_PY / \"master_admin.marshal.xz\"\nMARSHAL_SCHEMA_VERSION = 2\n\nADMIN_DICT_DIR = REPO_ROOT / \"data\" / \"admin_dictionary\"\nADMIN_2TIER_PATH = ADMIN_DICT_DIR / \"2tier_admin_dictionary.csv\"\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_06004e075d6ae096016ae7e3afbed08191bfe524b7f276d235"}},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '205,240p' vihap/cleaners/text_utils.py; sed -n '1,65p' vihap/cleaners/unicode.py; sed -n '1,47p' scripts/build_knowledge_base.py\", \"workdir\": \"/tmp/utility-corpus-2026-11-02/vihap\"}"},"time":{"start":1793581999899,"end":1793582000026}}}}
