{"type":"tool_use","timestamp":1793581992222,"sessionID":"ses_util_oc_kgc_r2_P3","part":{"partID":"prt_199d148a7001McXSSF8FHqWsHA","sessionID":"ses_util_oc_kgc_r2_P3","messageID":"msg_199d12caa001lRbkHjSfvw9iEz","type":"tool","id":"call_1c3ebc499d594f10b13213d1fea9bd34","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1,175p' vihap/cleaners/admin.py","workdir":"/tmp/utility-corpus-2026-11-02/vihap"},"output":"\"\"\"Administrative name normalizer and canonical alias engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport functools\nimport unicodedata\n\nfrom rapidfuzz import fuzz\n\nfrom ..grammar.admin import (\n    ADMIN_PREFIX_PATTERN,\n    REGIONAL_ALIASES,\n    build_province_mention_pattern,\n    build_word_boundary_pattern,\n)\nfrom ..grammar.admin import (\n    PROVINCE_PREFIX_RE as _PROVINCE_PREFIX_RE,\n)\nfrom ..grammar.sanitizers import DASH_WHITESPACE_RUN_RE as _DASH_WHITESPACE_RUN_RE\nfrom .text_utils import collapse_whitespace, normalize_ascii\n\n\n@functools.lru_cache(maxsize=4096)\ndef strip_province_prefix(text: str | None) -> str:\n    \"\"\"Strip province/city prefixes (Thành phố, Tỉnh, TP., TP) from text.\"\"\"\n    if not text:\n        return \"\"\n    return collapse_whitespace(_PROVINCE_PREFIX_RE.sub(\"\", text.strip()))\n\n\n@functools.lru_cache(maxsize=4096)\ndef strip_admin_prefix(text: str | None) -> str:\n    \"\"\"Strip standard administrative prefixes using ADMIN_PREFIX_PATTERN.\"\"\"\n    if not text:\n        return \"\"\n    return collapse_whitespace(ADMIN_PREFIX_PATTERN.sub(\"\", text.strip()))\n\n\n@functools.lru_cache(maxsize=8192)\ndef strip_and_norm_admin(text: str | None) -> str:\n    \"\"\"Strip standard administrative prefixes and return normalized lowercase ASCII.\"\"\"\n    if not text:\n        return \"\"\n    return normalize_ascii(strip_admin_prefix(text))\n\n\n@functools.lru_cache(maxsize=8192)\ndef normalize_admin_name(name: str | None) -> str:\n    \"\"\"Normalize administrative names for indexing, merging, and entity matching.\n\n    - Returns \"\" if name is None or empty.\n    - Normalize to ASCII lowercase and strip diacritics via normalize_ascii().\n    - Map common regional aliases:\n      - {\"tp.hcm\", \"tp hcm\", \"tphcm\", \"hcm\", \"sai gon\"} -> \"ho chi minh\"\n      - {\"tp.hn\", \"tp hn\", \"tphn\", \"hn\"} -> \"ha noi\"\n    - Strip official administrative prefixes using word boundaries:\n      tỉnh, thành phố, tp., tp, t., quận, q., q, huyện, h., h, thị xã, tx., tx,\n      phường, p., p, xã, x., x, thị trấn, tt., tt.\n      Be careful with single letters (q, h, p, t, x) so that words like \"quang ninh\",\n      \"ha giang\", \"phan thiet\" are not altered.\n    - Whitespace collapsing via collapse_whitespace() or regex.\n\n    Parameters\n    ----------\n    name : str | None\n        Administrative unit name (province, district, ward).\n\n    Returns\n    -------\n    str\n        Canonical normalized administrative name in ASCII lowercase.\n\n    Examples\n    --------\n    >>> normalize_admin_name(\"Thành phố Hồ Chí Minh\")\n    'ho chi minh'\n    >>> normalize_admin_name(\"TP.HCM\")\n    'ho chi minh'\n    >>> normalize_admin_name(\"Quận Ninh Kiều\")\n    'ninh kieu'\n    >>> normalize_admin_name(\"Thị trấn Trâu Quỳ\")\n    'trau quy'\n    >>> normalize_admin_name(\"Xã An Khánh\")\n    'an khanh'\n    \"\"\"\n    if not name:\n        return \"\"\n    cleaned = collapse_whitespace(name)\n    if not cleaned:\n        return \"\"\n\n    norm = normalize_ascii(cleaned)\n    norm = _DASH_WHITESPACE_RUN_RE.sub(\" \", norm).strip()\n    # Check if raw normalized string is a regional alias\n    if norm in REGIONAL_ALIASES:\n        return REGIONAL_ALIASES[norm]\n\n    # Strip official administrative prefix\n    stripped = strip_admin_prefix(norm)\n    if not stripped:\n        return \"\"\n\n    # Check if remainder matches a regional alias (e.g. 'Thành phố HCM' -> 'hcm' -> 'ho chi minh')\n    if stripped in REGIONAL_ALIASES:\n        return REGIONAL_ALIASES[stripped]\n\n    return collapse_whitespace(stripped)\n\n\ndef user_admin_token_has_diacritics(token: str) -> bool:\n    \"\"\"True when the user token contains Vietnamese diacritics (not ASCII-only).\"\"\"\n    core = ADMIN_PREFIX_PATTERN.sub(\"\", token.strip())\n    if not core:\n        return False\n    nfc = unicodedata.normalize(\"NFC\", core)\n    return normalize_ascii(nfc) != nfc.casefold()\n\n\ndef user_admin_token_matches_official_name(user_token: str, official_name: str) -> bool:\n    \"\"\"NFC case-insensitive match of user token core to official admin name (prefixes stripped).\"\"\"\n    user_core = unicodedata.normalize(\n        \"NFC\",\n        strip_admin_prefix(user_token.strip()),\n    )\n    official_core = unicodedata.normalize(\"NFC\", strip_admin_prefix(official_name.strip()))\n    return user_core.casefold() == official_core.casefold()\n\n\ndef ascii_norm_admin_cores_collide_but_diacritics_differ(\n    official_a: str,\n    official_b: str,\n) -> bool:\n    \"\"\"True when ASCII cores match but NFC diacritics differ (e.g. Thuận Hòa vs Thuận Hóa).\"\"\"\n    a_core = strip_admin_prefix(official_a.strip())\n    b_core = strip_admin_prefix(official_b.strip())\n    if normalize_ascii(a_core) != normalize_ascii(b_core):\n        return False\n    return (\n        unicodedata.normalize(\"NFC\", a_core).casefold()\n        != unicodedata.normalize(\"NFC\", b_core).casefold()\n    )\n\n\ndef is_admin_match(\n    declared_name: str | None,\n    resolved_name: str | None,\n    threshold: float = 0.85,\n) -> bool:\n    \"\"\"Compare two administrative unit names using canonical normalization and token sort similarity.\"\"\"\n    if (\n        not declared_name\n        or not declared_name.strip()\n        or not resolved_name\n        or not resolved_name.strip()\n    ):\n        return True\n\n    d = normalize_admin_name(declared_name)\n    r = normalize_admin_name(resolved_name)\n\n    if not d and not r:\n        return True\n    if not d or not r:\n        return False\n    if d == r:\n        return True\n\n    score = fuzz.token_sort_ratio(d, r)\n    cutoff = threshold * 100.0 if threshold <= 1.0 else threshold\n    return score >= cutoff\n\n\ndef strip_province_mention(query: str | None, province: str | None) -> str:\n    \"\"\"Remove target province mention (with optional prefix) from query text.\"\"\"\n    if not query:\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"\"\"\"Administrative name normalizer and canonical alias engine.\"\"\"\n\nfrom __future__ import annotations\n\nimport functools\nimport unicodedata\n\nfrom rapidfuzz import fuzz\n\nfrom ..grammar.admin import (\n    ADMIN_PREFIX_PATTERN,\n    REGIONAL_ALIASES,\n    build_province_mention_pattern,\n    build_word_boundary_pattern,\n)\nfrom ..grammar.admin import (\n    PROVINCE_PREFIX_RE as _PROVINCE_PREFIX_RE,\n)\nfrom ..grammar.sanitizers import DASH_WHITESPACE_RUN_RE as _DASH_WHITESPACE_RUN_RE\nfrom .text_utils import collapse_whitespace, normalize_ascii\n\n\n@functools.lru_cache(maxsize=4096)\ndef strip_province_prefix(text: str | None) -> str:\n    \"\"\"Strip province/city prefixes (Thành phố, Tỉnh, TP., TP) from text.\"\"\"\n    if not text:\n        return \"\"\n    return collapse_whitespace(_PROVINCE_PREFIX_RE.sub(\"\", text.strip()))\n\n\n@functools.lru_cache(maxsize=4096)\ndef strip_admin_prefix(text: str | None) -> str:\n    \"\"\"Strip standard administrative prefixes using ADMIN_PREFIX_PATTERN.\"\"\"\n    if not text:\n        return \"\"\n    return collapse_whitespace(ADMIN_PREFIX_PATTERN.sub(\"\", text.strip()))\n\n\n@functools.lru_cache(maxsize=8192)\ndef strip_and_norm_admin(text: str | None) -> str:\n    \"\"\"Strip standard administrative prefixes and return normalized lowercase ASCII.\"\"\"\n    if not text:\n        return \"\"\n    return normalize_ascii(strip_admin_prefix(text))\n\n\n@functools.lru_cache(maxsize=8192)\ndef normalize_admin_name(name: str | None) -> str:\n    \"\"\"Normalize administrative names for indexing, merging, and entity matching.\n\n    - Returns \"\" if name is None or empty.\n    - Normalize to ASCII lowercase and strip diacritics via normalize_ascii().\n    - Map common regional aliases:\n      - {\"tp.hcm\", \"tp hcm\", \"tphcm\", \"hcm\", \"sai gon\"} -> \"ho chi minh\"\n      - {\"tp.hn\", \"tp hn\", \"tphn\", \"hn\"} -> \"ha noi\"\n    - Strip official administrative prefixes using word boundaries:\n      tỉnh, thành phố, tp., tp, t., quận, q., q, huyện, h., h, thị xã, tx., tx,\n      phường, p., p, xã, x., x, thị trấn, tt., tt.\n      Be careful with single letters (q, h, p, t, x) so that words like \"quang ninh\",\n      \"ha giang\", \"phan thiet\" are not altered.\n    - Whitespace collapsing via collapse_whitespace() or regex.\n\n    Parameters\n    ----------\n    name : str | None\n        Administrative unit name (province, district, ward).\n\n    Returns\n    -------\n    str\n        Canonical normalized administrative name in ASCII lowercase.\n\n    Examples\n    --------\n    >>> normalize_admin_name(\"Thành phố Hồ Chí Minh\")\n    'ho chi minh'\n    >>> normalize_admin_name(\"TP.HCM\")\n    'ho chi minh'\n    >>> normalize_admin_name(\"Quận Ninh Kiều\")\n    'ninh kieu'\n    >>> normalize_admin_name(\"Thị trấn Trâu Quỳ\")\n    'trau quy'\n    >>> normalize_admin_name(\"Xã An Khánh\")\n    'an khanh'\n    \"\"\"\n    if not name:\n        return \"\"\n    cleaned = collapse_whitespace(name)\n    if not cleaned:\n        return \"\"\n\n    norm = normalize_ascii(cleaned)\n    norm = _DASH_WHITESPACE_RUN_RE.sub(\" \", norm).strip()\n    # Check if raw normalized string is a regional alias\n    if norm in REGIONAL_ALIASES:\n        return REGIONAL_ALIASES[norm]\n\n    # Strip official administrative prefix\n    stripped = strip_admin_prefix(norm)\n    if not stripped:\n        return \"\"\n\n    # Check if remainder matches a regional alias (e.g. 'Thành phố HCM' -> 'hcm' -> 'ho chi minh')\n    if stripped in REGIONAL_ALIASES:\n        return REGIONAL_ALIASES[stripped]\n\n    return collapse_whitespace(stripped)\n\n\ndef user_admin_token_has_diacritics(token: str) -> bool:\n    \"\"\"True when the user token contains Vietnamese diacritics (not ASCII-only).\"\"\"\n    core = ADMIN_PREFIX_PATTERN.sub(\"\", token.strip())\n    if not core:\n        return False\n    nfc = unicodedata.normalize(\"NFC\", core)\n    return normalize_ascii(nfc) != nfc.casefold()\n\n\ndef user_admin_token_matches_official_name(user_token: str, official_name: str) -> bool:\n    \"\"\"NFC case-insensitive match of user token core to official admin name (prefixes stripped).\"\"\"\n    user_core = unicodedata.normalize(\n        \"NFC\",\n        strip_admin_prefix(user_token.strip()),\n    )\n    official_core = unicodedata.normalize(\"NFC\", strip_admin_prefix(official_name.strip()))\n    return user_core.casefold() == official_core.casefold()\n\n\ndef ascii_norm_admin_cores_collide_but_diacritics_differ(\n    official_a: str,\n    official_b: str,\n) -> bool:\n    \"\"\"True when ASCII cores match but NFC diacritics differ (e.g. Thuận Hòa vs Thuận Hóa).\"\"\"\n    a_core = strip_admin_prefix(official_a.strip())\n    b_core = strip_admin_prefix(official_b.strip())\n    if normalize_ascii(a_core) != normalize_ascii(b_core):\n        return False\n    return (\n        unicodedata.normalize(\"NFC\", a_core).casefold()\n        != unicodedata.normalize(\"NFC\", b_core).casefold()\n    )\n\n\ndef is_admin_match(\n    declared_name: str | None,\n    resolved_name: str | None,\n    threshold: float = 0.85,\n) -> bool:\n    \"\"\"Compare two administrative unit names using canonical normalization and token sort similarity.\"\"\"\n    if (\n        not declared_name\n        or not declared_name.strip()\n        or not resolved_name\n        or not resolved_name.strip()\n    ):\n        return True\n\n    d = normalize_admin_name(declared_name)\n    r = normalize_admin_name(resolved_name)\n\n    if not d and not r:\n        return True\n    if not d or not r:\n        return False\n    if d == r:\n        return True\n\n    score = fuzz.token_sort_ratio(d, r)\n    cutoff = threshold * 100.0 if threshold <= 1.0 else threshold\n    return score >= cutoff\n\n\ndef strip_province_mention(query: str | None, province: str | None) -> str:\n    \"\"\"Remove target province mention (with optional prefix) from query text.\"\"\"\n    if not query:\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_06004e075d6ae096016ae7e3a5ed7481918f32712002812927"}},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '1,175p' vihap/cleaners/admin.py\", \"workdir\": \"/tmp/utility-corpus-2026-11-02/vihap\"}"},"time":{"start":1793581992103,"end":1793581992222}}}}
{"type":"tool_use","timestamp":1793581992241,"sessionID":"ses_util_oc_kgc_r2_P3","part":{"partID":"prt_199d148b1001aklFUrZ7CvEKvR","sessionID":"ses_util_oc_kgc_r2_P3","messageID":"msg_199d12caa001lRbkHjSfvw9iEz","type":"tool","id":"call_6f9ec55750204a3eaef312d88686d82a","tool":"shell","state":{"status":"completed","input":{"command":"sed -n '1400,1465p' scripts/build_knowledge_base.py","workdir":"/tmp/utility-corpus-2026-11-02/vihap"},"output":"    cursor = conn.cursor()\n\n    streets_by_district, districts_by_street = admin.get_district_streets_mapping()\n    prov_name_to_code, prov_ward_map = admin.get_prov_ward_reform_map()\n\n    # Metadata\n    metadata = dict(cursor.execute(\"SELECT key, value FROM metadata\").fetchall())\n\n    # Centroids\n    ward_centroids = {}\n    cursor.execute(\"SELECT code, lat, lon FROM wards WHERE lat IS NOT NULL AND lon IS NOT NULL\")\n    for w_code, lat, lon in cursor.fetchall():\n        if w_code:\n            ward_centroids[str(w_code).strip()] = (float(lat), float(lon))\n\n    # Named centroids\n    d_m: dict[tuple[str, str], tuple[float, float]] = {}\n    w_m: dict[tuple[str, str, str], tuple[float, float]] = {}\n    w2_m: dict[tuple[str, str], tuple[float, float]] = {}\n    cursor.execute(\n        \"SELECT p.name, d.name, d.lat, d.lon FROM districts d JOIN provinces p ON d.province_code = p.code WHERE d.lat IS NOT NULL\"\n    )\n    for p_name, d_name, lat, lon in cursor.fetchall():\n        d_m[(normalize_admin_name(p_name), normalize_admin_name(d_name))] = (float(lat), float(lon))\n    cursor.execute(\n        \"SELECT p.name, d.name, w.name, w.lat, w.lon FROM wards w JOIN districts d ON w.district_code = d.code JOIN provinces p ON w.province_code = p.code WHERE w.lat IS NOT NULL\"\n    )\n    for p_name, d_name, w_name, lat, lon in cursor.fetchall():\n        w_m[\n            (\n                normalize_admin_name(p_name),\n                normalize_admin_name(d_name),\n                normalize_admin_name(w_name),\n            )\n        ] = (float(lat), float(lon))\n    cursor.execute(\n        \"SELECT p.name, w.name, w.lat, w.lon FROM wards_2tier w JOIN provinces_2tier p ON w.province_code = p.code WHERE w.lat IS NOT NULL\"\n    )\n    for p_name, w_name, lat, lon in cursor.fetchall():\n        w2_m[(normalize_admin_name(p_name), normalize_admin_name(w_name))] = (\n            float(lat),\n            float(lon),\n        )\n    named_centroids = (d_m, w_m, w2_m)\n\n    # Reforms\n    w_clusters = _build_ward_merger_clusters_from_sqlite(conn)\n    prov_reforms: set[tuple[str, str]] = set()\n    cursor.execute(\n        \"\"\"\n        SELECT ro.old_province, p2.name\n        FROM reform_origins ro\n        JOIN wards_2tier w2 ON ro.new_ward_code = w2.code\n        JOIN provinces_2tier p2 ON w2.province_code = p2.code\n        WHERE ro.old_province IS NOT NULL AND p2.name IS NOT NULL\n        \"\"\"\n    )\n    for old_p, new_p in cursor.fetchall():\n        norm_old = normalize_admin_name(old_p)\n        norm_new = normalize_admin_name(new_p)\n        if norm_old and norm_new:\n            prov_reforms.add((norm_old, norm_new))\n\n    parent_codes: dict[str, tuple[str | None, str | None]] = {}\n    cursor.execute(\"SELECT code, province_code, district_code FROM wards WHERE code IS NOT NULL\")\n    for w_code, p_code, d_code in cursor.fetchall():\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"    cursor = conn.cursor()\n\n    streets_by_district, districts_by_street = admin.get_district_streets_mapping()\n    prov_name_to_code, prov_ward_map = admin.get_prov_ward_reform_map()\n\n    # Metadata\n    metadata = dict(cursor.execute(\"SELECT key, value FROM metadata\").fetchall())\n\n    # Centroids\n    ward_centroids = {}\n    cursor.execute(\"SELECT code, lat, lon FROM wards WHERE lat IS NOT NULL AND lon IS NOT NULL\")\n    for w_code, lat, lon in cursor.fetchall():\n        if w_code:\n            ward_centroids[str(w_code).strip()] = (float(lat), float(lon))\n\n    # Named centroids\n    d_m: dict[tuple[str, str], tuple[float, float]] = {}\n    w_m: dict[tuple[str, str, str], tuple[float, float]] = {}\n    w2_m: dict[tuple[str, str], tuple[float, float]] = {}\n    cursor.execute(\n        \"SELECT p.name, d.name, d.lat, d.lon FROM districts d JOIN provinces p ON d.province_code = p.code WHERE d.lat IS NOT NULL\"\n    )\n    for p_name, d_name, lat, lon in cursor.fetchall():\n        d_m[(normalize_admin_name(p_name), normalize_admin_name(d_name))] = (float(lat), float(lon))\n    cursor.execute(\n        \"SELECT p.name, d.name, w.name, w.lat, w.lon FROM wards w JOIN districts d ON w.district_code = d.code JOIN provinces p ON w.province_code = p.code WHERE w.lat IS NOT NULL\"\n    )\n    for p_name, d_name, w_name, lat, lon in cursor.fetchall():\n        w_m[\n            (\n                normalize_admin_name(p_name),\n                normalize_admin_name(d_name),\n                normalize_admin_name(w_name),\n            )\n        ] = (float(lat), float(lon))\n    cursor.execute(\n        \"SELECT p.name, w.name, w.lat, w.lon FROM wards_2tier w JOIN provinces_2tier p ON w.province_code = p.code WHERE w.lat IS NOT NULL\"\n    )\n    for p_name, w_name, lat, lon in cursor.fetchall():\n        w2_m[(normalize_admin_name(p_name), normalize_admin_name(w_name))] = (\n            float(lat),\n            float(lon),\n        )\n    named_centroids = (d_m, w_m, w2_m)\n\n    # Reforms\n    w_clusters = _build_ward_merger_clusters_from_sqlite(conn)\n    prov_reforms: set[tuple[str, str]] = set()\n    cursor.execute(\n        \"\"\"\n        SELECT ro.old_province, p2.name\n        FROM reform_origins ro\n        JOIN wards_2tier w2 ON ro.new_ward_code = w2.code\n        JOIN provinces_2tier p2 ON w2.province_code = p2.code\n        WHERE ro.old_province IS NOT NULL AND p2.name IS NOT NULL\n        \"\"\"\n    )\n    for old_p, new_p in cursor.fetchall():\n        norm_old = normalize_admin_name(old_p)\n        norm_new = normalize_admin_name(new_p)\n        if norm_old and norm_new:\n            prov_reforms.add((norm_old, norm_new))\n\n    parent_codes: dict[str, tuple[str | None, str | None]] = {}\n    cursor.execute(\"SELECT code, province_code, district_code FROM wards WHERE code IS NOT NULL\")\n    for w_code, p_code, d_code in cursor.fetchall():\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_06004e075d6ae096016ae7e3a7f49c81918bd7553cce42bd80"}},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '1400,1465p' scripts/build_knowledge_base.py\", \"workdir\": \"/tmp/utility-corpus-2026-11-02/vihap\"}"},"time":{"start":1793581992113,"end":1793581992241}}}}
