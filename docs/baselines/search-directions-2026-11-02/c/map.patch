+/// Proactive symbol map: top symbols by distinct resolved call fan-in.
+/// Static centrality over `calls` edges; not a semantic summary.
+pub fn map(
+    conn: &Connection,
+    limit: usize,
+    path: Option<&str>,
+    exclude_generated: bool,
+) -> Result<Vec<String>> {
+    const MAP_CAVEAT: &str =
+        "kg: map — static centrality over resolved call edges; importance is not a summary";
+    let limit = crate::query::clamp_limit(limit)?;
+    if let Some(p) = path {
+        crate::query::validate_path_scope(p, false)?;
+    }
+    let mut scope = crate::query::path_scope_sql_pub("f", path);
+    if exclude_generated {
+        scope.push_str(" AND f.generated = 0");
+    }
+    let total: usize = conn.query_row(
+        &format!(
+            "SELECT COUNT(DISTINCT s.id) FROM edges e
+             JOIN symbols s ON s.id = e.dst_id
+             JOIN files f ON f.id = s.file_id
+             WHERE e.kind = 'calls' AND e.dst_id IS NOT NULL {scope}"
+        ),
+        [],
+        |r| r.get::<_, i64>(0),
+    )? as usize;
+    if total == 0 {
+        return Err(KgError::NoResults(
+            "0 symbols with resolved call fan-in".to_string(),
+        ));
+    }
+    let mut stmt = conn.prepare(&format!(
+        "SELECT f.path, s.line_start, s.kind, s.qualname, s.signature,
+                COUNT(DISTINCT e.src_id) AS fan_in
+         FROM edges e
+         JOIN symbols s ON s.id = e.dst_id
+         JOIN files f ON f.id = s.file_id
+         WHERE e.kind = 'calls' AND e.dst_id IS NOT NULL {scope}
+         GROUP BY s.id
+         ORDER BY fan_in DESC, s.qualname, f.path, s.line_start
+         LIMIT {limit}"
+    ))?;
+    let rows = stmt
+        .query_map([], |r| {
+            Ok((
+                r.get::<_, String>(0)?,
+                r.get::<_, i64>(1)?,
+                r.get::<_, String>(2)?,
+                r.get::<_, String>(3)?,
+                r.get::<_, String>(4)?,
+                r.get::<_, i64>(5)?,
+            ))
+        })?
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    let shown = rows.len();
+    let mut out = vec![MAP_CAVEAT.to_string()];
+    for (path, line, kind, qualname, signature, fan_in) in rows {
+        let sig = if signature.is_empty() {
+            String::new()
+        } else {
+            format!(" {signature}")
+        };
+        out.push(format!(
+            "{path}:{line} {kind} {qualname}{sig} fan_in={fan_in}"
+        ));
+    }
+    if total > shown {
+        out.push(format!("showing {shown} of {total}"));
+        eprintln!("[kg] capped at {shown} results ({total} total)");
+    }
+    Ok(out)
+}
