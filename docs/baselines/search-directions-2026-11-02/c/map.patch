+#[test]
+fn map_ranks_symbols_by_call_fan_in() {
+    let repo = temp_repo("map-fanin");
+    write(
+        &repo,
+        "a.py",
+        "def target():\n    return 1\n\ndef target2():\n    return 2\n\ndef c1():\n    return target()\n\ndef c2():\n    return target()\n\ndef c3():\n    return target2()\n",
+    );
+    build(&repo);
+    let out = kg(&repo).args(["map", "--limit", "5"]).output().unwrap();
+    let stdout = String::from_utf8_lossy(&out.stdout);
+    assert_eq!(out.status.code(), Some(0), "{stdout}");
+    assert!(stdout.starts_with("kg: map —"), "{stdout}");
+    let target = stdout
+        .lines()
+        .position(|l| l.contains("a.target"))
+        .expect("target row");
+    let other = stdout
+        .lines()
+        .position(|l| l.contains("a.target2"))
+        .expect("target2 row");
+    assert!(target < other, "fan-in order: {stdout}");
+    assert!(stdout.contains("fan_in=2"), "{stdout}");
+
+    let out = kg(&repo)
+        .args(["map", "--limit", "5", "--path", "a.py"])
+        .output()
+        .unwrap();
+    let stdout = String::from_utf8_lossy(&out.stdout);
+    assert_eq!(out.status.code(), Some(0), "{stdout}");
+    assert!(stdout.contains("a.target"), "{stdout}");
+
+    let empty = temp_repo("map-empty");
+    write(&empty, "a.py", "def lonely():\n    return 1\n");
+    build(&empty);
+    let out = kg(&empty).args(["map"]).output().unwrap();
+    assert_eq!(out.status.code(), Some(1));
+    assert!(
+        String::from_utf8_lossy(&out.stderr).contains("0 symbols with resolved call fan-in"),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
