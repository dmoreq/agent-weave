+/// Test-file path classes used only by the opt-in source-first ranking.
+fn path_is_test(path: &str) -> bool {
+    path.starts_with("tests/") || path.contains("/tests/")
+}
+
+fn query_wants_tests(tokens: &[String], path: Option<&str>) -> bool {
+    if path.is_some_and(|p| p.starts_with("tests") || p.contains("/tests")) {
+        return true;
+    }
+    tokens.iter().any(|t| {
+        matches!(
+            t.as_str(),
+            "test" | "tests" | "spec" | "specs" | "fixture" | "fixtures"
+        )
+    })
+}
