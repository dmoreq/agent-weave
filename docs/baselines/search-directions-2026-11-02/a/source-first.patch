+#[test]
+fn prefer_source_demotes_test_paths() {
+    let repo = temp_repo("prefer-source");
+    write(
+        &repo,
+        "src.py",
+        "def resolve_target(value):\n    return value\n",
+    );
+    write(
+        &repo,
+        "tests/test_x.py",
+        "def test_resolve_target(value):\n    return value\n",
+    );
+    build(&repo);
+    let out = kg(&repo)
+        .args(["search", "resolve target"])
+        .output()
+        .unwrap();
+    let plain = String::from_utf8_lossy(&out.stdout);
+    assert_eq!(out.status.code(), Some(0), "{plain}");
+    let out = kg(&repo)
+        .args(["search", "resolve target", "--prefer-source"])
+        .output()
+        .unwrap();
+    let preferred = String::from_utf8_lossy(&out.stdout);
+    assert_eq!(out.status.code(), Some(0), "{preferred}");
+    let src = preferred.find("src.py").expect("source hit");
+    let test = preferred.find("tests/test_x.py").expect("test hit");
+    assert!(src < test, "source-first order: {preferred}");
+    assert!(
+        !preferred.contains("showing 1 of"),
+        "flag must not drop the test hit: {preferred}"
+    );
+
+    // A query that explicitly asks for tests is not demoted.
+    let out = kg(&repo)
+        .args(["search", "test resolve target", "--prefer-source"])
+        .output()
+        .unwrap();
+    let asked = String::from_utf8_lossy(&out.stdout);
+    assert!(
+        asked.find("tests/test_x.py").expect("test hit") < asked.find("src.py").expect("src hit"),
+        "test query keeps test first: {asked}"
+    );
+}
